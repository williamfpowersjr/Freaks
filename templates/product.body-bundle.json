        "item_JRQXRR": {
          "type": "item",
          "settings": {
            "title": "Step 1",
            "description": "<p>After AM/PM cleansing, or when you wash yourself after a workout session, apply one pump of the Deeper Dive Moisturizer into hands and gently rub onto face, neck and chest if applicable. For optimal results use in the AM and PM.</p>",
            "image": "shopify://shop_images/application-01-endurance-system.jpg",
            "hide_mute": false,
            "full_bleed_media": false
          }
        },
        "item_C7UB4d": {
          "type": "item",
          "settings": {
            "title": "Step 2",
            "description": "<p>Apply Daily Defender SPF30 or Peak Performance SPF50 Sunscreen in the morning before you go outside, or 15 minutes before going in the sun, and as the final step in your daily skincare routine. Apply one pump amount or more of our sunscreen selection into hands and gently rub onto face, neck, chest and body if applicable.</p>",
            "image": "shopify://shop_images/application-02-endurance-system.jpg",
            "hide_mute": false,
            "full_bleed_media": false
          }
        },
        "item_bQdhy9": {
          "type": "item",
          "settings": {
            "title": "Step 3",
            "description": "<p>Reapply after 40 or 80 min, depending on your sunscreen selection and the amount of of swimming or sweating, immediately after towel drying and at least every 2 hours when exposed to the sun.</p>",
            "image": "shopify://shop_images/application-03-endurance-system.jpg",
            "hide_mute": false,
            "full_bleed_media": false
          }
        }
      },

    "lp_faq": {
      "type": "lp-faq",
      "blocks": {
        "q_last": {
          "type": "question",
          "settings": {
            "question": "How long does each mini last?",
            "answer": "<p>About a week with daily use. Four minis gets you through about a month.</p>"
          }
        },
        "q_aluminum": {
          "type": "question",
          "settings": {
            "question": "Is there aluminum or baking soda in it?",
            "answer": "<p>No. Zero aluminum and zero baking soda. It stops odor at the source without blocking sweat.</p>"
          }
        },
        "q_scents": {
          "type": "question",
          "settings": {
            "question": "Which scents are in the set?",
            "answer": "<p>One mini of each Everyday Endurance scent: Santal Dune, Cedar Peak, Bergamot Canyon and Solar Atoll.</p>"
          }
        },
        "q_use": {
          "type": "question",
          "settings": {
            "question": "How do I use it?",
            "answer": "<p>Remove the top and twist the bottom until the formula starts to appear through the cap. Don’t overtwist: a little goes a long way. Apply to clean, dry underarms. Keep it at room temperature for best results.</p>"
          }
        },
        "q_holiday": {
          "type": "question",
          "settings": {

    "lp_reviews": {
      "type": "lp-reviews",
      "blocks": {
        "review_robert": {
          "type": "review",
          "settings": {
            "title": "Works as advertised",
            "quote": "I work out every day and I sweat a lot. Usually after a workout, the pits are gonna smell but since I’ve been using FON deodorant, you really get protection for 48 hours. Normally, I would put deodorant on every day as force of habit, but with this I do it every other day. Great product and smells are unique- they are really good.",
            "name": "Robert C."
          }
        },
        "review_camille": {
          "type": "review",
          "settings": {
            "title": "Finally Clean deodorant that works!",
            "quote": "Works! Finally a clean deodorant that works all day!",
            "name": "Camille P."
          }
        },
        "review_darrin": {
          "type": "review",
          "settings": {
            "title": "",
            "quote": "Goes on clean, not greasy, clean ingredients, last long even under pressure.",
            "name": "Darrin S."
          }
        },
        "review_lindsay": {
          "type": "review",
          "settings": {
            "title": "10/10 deodorant",
            "quote": "It really works! I apply early in the morning & last all day! My husband & I love this product",
            "name": "Lindsay T."
          }
        },
        "review_drew": {
          "type": "review",
          "settings": {
            "title": "Great smell. Clean Ingredients",
            "quote": "Smell is great. I can't believe how long it last. Love the clean ingredients most of all",
            "name": "Drew H."
          }
        }
      },

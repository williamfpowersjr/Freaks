    "lp_why": {
      "type": "lp-why",
      "blocks": {
        "ingredient_zinc": {
          "type": "ingredient",
          "settings": {
            "name": "Zinc Ricinoleate",
            "role": "Traps odor",
            "text": "Derived from castor oil. It traps odor compounds and neutralizes them without disrupting your skin’s microbiome.",
            "image": "shopify://shop_images/Ingredients_V2_6cb759eb-e242-4101-998a-b23b2e03c8bf.jpg"
          }
        },
        "ingredient_sinodor": {
          "type": "ingredient",
          "settings": {
            "name": "Sinodor",
            "role": "Removes odor",
            "text": "Targets and binds to malodor molecules. Instead of masking odor, it removes it, so good bacteria can thrive.",
            "image": "shopify://shop_images/Sinodor.jpg"
          }
        },
        "ingredient_smart": {
          "type": "ingredient",
          "settings": {
            "name": "SMA’RT TEC",
            "role": "Stops odor forming",
            "text": "Disrupts the enzyme activity that turns sweat into body odor. No need to block sweat.",
            "image": "shopify://shop_images/SMA_RT_TEC.jpg"
          }
        }
      },
      "block_order": [
        "ingredient_zinc",
        "ingredient_sinodor",
        "ingredient_smart"
      ],
      "settings": {
        "eyebrow": "Why it works",
        "heading": "Stops odor at the source.",
        "text": "<p>Body odor starts when enzyme activity turns sweat into smell. Everyday Endurance works with your microbiome to stop it at the source. Odor-causing bacteria are kept at bay. The good bacteria that keep your skin healthy are left to thrive.</p>",
        "proof": "48-hour odor protection. Zero aluminum. Zero baking soda.",
        "quote": "This is the best deodorant I've used. Even after the most humid day, there's no smell. Highly recommend.",
        "quote_name": "Matt H.",
        "cta": "Get all four for {price}"
      }
    },

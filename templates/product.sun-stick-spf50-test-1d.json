            "tag_2": "",
            "tag_3": ""
          }
        },
        "card_UzGHJp": {
          "type": "card",
          "settings": {
            "text": "<ul><li>Manufactured from 100% wild-grown and hand-picked Alpenrose Flowers from a farming family in the Swiss Alps. High sustainable quality and full traceability.</li><li>Protects skin from environmental stressor while providing powerful antioxidants to combat daily skin stressors.</li></ul>",
            "tag_thumbnail_1": "shopify://shop_images/Screenshot_2024-05-04_at_6.42.18_PM.png",
            "tag_1": "Alpenrose Flower",
            "tag_2": "",
            "tag_3": ""
          }
        },
        "card_46jfgR": {
          "type": "card",
          "settings": {
            "text": "<ul><li>Also known as brown algae, this seaweed is a rich source of nutrients and benefits skin when applied topically.</li><li>Rich in marine antioxidants to help protect skin from environmental stressors and defend against pollution and UV-induced skin stress.</li></ul>",
            "tag_thumbnail_1": "shopify://shop_images/Screenshot_2024-05-04_at_6.48.46_PM.png",
            "tag_1": "Wakame Extract",
            "tag_2": "",

    "faqs_FJfe4R": {
      "type": "faqs",
      "blocks": {
        "accordion_LdhkfA": {
          "type": "accordion",
          "settings": {
            "title": "How do I refill my deodorant? ",
            "description": "<p>Each deodorant comes with a removable perforated cap and can be easily refilled in a few simple steps:</p><ol><li><strong>Prepare the refill:</strong> Twist off the refill pouch spout cover.</li><li><strong>Remove the cap:</strong> Twist and pull the deodorant’s perforated cap upward.</li><li><strong>Refill:</strong> Pour the formula from the refill pouch into your deodorant. <em>Tip: If your deodorant is empty, twist the bottom of the bottle to ensure the internal mechanism is at the base.</em></li><li><strong>Secure the cap:</strong> Reapply the perforated cap until you hear a click, indicating it’s properly fastened.</li></ol>"
          }
        },
        "accordion_CwE3wK": {
          "type": "accordion",
          "settings": {
            "title": "How long does each deodorant last? ",
            "description": "<p>Each deodorant is filled with approximately 30 days worth of formula. </p>"
          }
        },

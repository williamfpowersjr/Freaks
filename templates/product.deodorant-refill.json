    "builder_system_QrMt66": {
      "type": "builder-system",
      "blocks": {
        "card_4XJCrn": {
          "type": "card",
          "settings": {
            "text": "<ul><li><strong>Highly effective odor-absorbing agent</strong> that tackles unwanted smells at the source—without interfering with your skin’s natural processes.</li><li>Unlike harsh antibacterial ingredients, it <strong>neutralizes odor molecules without disrupting the delicate skin microbiome</strong>, keeping your underarms balanced, comfortable, and fresh.</li><li>Derived from castor oil, this gentle but powerful ingredient works by trapping odor compounds, making it a smart choice for those seeking clean, effective deodorant solutions.</li></ul>",
            "tag_thumbnail_1": "shopify://shop_images/Ingredients_V2_6cb759eb-e242-4101-998a-b23b2e03c8bf.jpg",
            "tag_1": "Zinc Ricinoleate",
            "tag_2": "",
            "tag_3": ""
          }
        },
        "card_weP93V": {
          "type": "card",
          "settings": {
            "text": "<ul><li><strong>Sinodor works by specifically targeting and binding to malodor molecules</strong>, effectively neutralizing unwanted smells at the source.</li><li>Instead of masking odor, it <strong>removes it entirely—creating a balanced environment where good bacteria can thrive and support a healthy skin microbiome.</strong></li><li>This smart, science-backed deodorizing ingredient makes it possible to stay fresh without compromising your skin’s natural ecosystem.</li></ul>",
            "tag_thumbnail_1": "shopify://shop_images/Sinodor.jpg",
            "tag_1": "Sinodor",
            "tag_2": "",
            "tag_3": ""
          }
        },
        "card_hfJfYt": {
          "type": "card",
          "settings": {
            "text": "<ul><li><strong>SMA’RT TEC is an advanced deodorizing technology that disrupts the enzyme activity responsible for turning sweat into body odor.</strong></li><li>By stopping malodor formation at the source, it <strong>keeps you feeling fresh—without the need to block sweat or disturb your skin’s natural balance.</strong></li></ul>",
            "tag_thumbnail_1": "shopify://shop_images/SMA_RT_TEC.jpg",
            "tag_1": "SMA’RT TEC",
            "tag_2": "",
            "tag_3": ""
          }
        }
      },
      "block_order": [

<div class="menu-bar--offset bg-offWhite">
  {%- render 'title',
    title: settings.giftcard_title,
    text_size: 'fn-tt-title-80 lg:fn-tt-title-70',
    extra_wrapper_classes: 'overflow-hidden text-center ',
    isH1: true,
    bg_lines: 'bg-grey-lines',
    bg_color: 'white'
  -%}
  {%- assign gift_card_price = '' -%}
  {% if settings.currency_code_enabled %}
    {%- assign gift_card_price = gift_card.balance | money_with_currency -%}

  {% else %}
    {%- assign gift_card_price = gift_card.balance | money -%}
  {% endif %}

  {%- render 'title',
    title: gift_card_price,
    text_size: 'fn-tt-title-80 lg:fn-tt-title-70',
    extra_wrapper_classes: 'overflow-hidden  text-center',
    isH1: true,
    bg_lines: 'bg-grey-lines',
    bg_color: 'white'
  -%}

  <div class="flex flex-col items-center px-24 py-40 lg:gap-y-64 lg:px-40 lg:py-80 lg:pb-40">
    <div class="flex flex-col gap-y-64">
      {%- render 'gift-card-image' -%}

      <div class="flex flex-col gap-y-40">
        <div class="flex flex-col items-center gap-y-40">
          <div id="gift-card-qr-code" data-identifier="{{ gift_card.qr_identifier }}"></div>

          <div class="flex flex-col items-center gap-y-8">
            <p
              id="gift-card-code"
              class="fn-tt-title-20 font-medium "
            >
              {{ gift_card.code | format_code }}
            </p>

            <button
              class="fn-tt-cta-40 duration-250 group flex h-fit items-center justify-center gap-x-4 bg-white p-16 text-center font-medium  uppercase transition-all ease-in-out lg:hover:bg-orange lg:hover:text-white print:hidden"
            >
              <svg class="h-16 w-17" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M11 10.5H14V2.5H6V5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M11 5.5H3V13.5H11V5.5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span id="gift-card-copy-code">Copy Code</span>
            </button>
          </div>
        </div>
        <div class="flex flex-col items-center gap-y-4">
          {%- render 'cta',
            as: 'a',
            href: settings.giftcard_cta_link,
            text: settings.giftcard_cta,
            cta_color: 'orange',
            hasIcon: true
          -%}
          {% render 'cta',
            as: 'button',
            cta_color: 'blue',
            hasIcon: true,
            text: 'Print',
            extra_classes: 'w-fit',
            extra_attributes: 'onclick="window.print()"'
          %}
        </div>
      </div>
    </div>
    <div hidden>
      <span id="a11y-new-window-message">Opens in a new window</span>
    </div>
  </div>
</div>

<script>
  const string = { qrImageAlt: 'QR code — scan to redeem gift card' };

  document.addEventListener('DOMContentLoaded', () => {
    const code = document.getElementById('gift-card-code');
    const qrCode = document.getElementById('gift-card-qr-code');
    const copyButton = document.getElementById('gift-card-copy-code');

    new QRCode(qrCode, {
      text: qrCode.dataset.identifier,
      width: 100,
      height: 100,
      imageAltText: string.qrImageAlt,
    });

    copyButton.addEventListener('click', () => {
      navigator.clipboard.writeText(code.innerText).then(() => {
        copyButton.innerText = 'Code copied successfully';
        copyButton.disabled = true;
      });
    });
  });
</script>

    "faqs_VGbbQF": {
      "type": "faqs",
      "blocks": {
        "accordion_zygz4k": {
          "type": "accordion",
          "settings": {
            "title": "Are your products vegan and cruelty free?",
            "description": "<p>Yes, all of our products are 100% vegan. When we reference things like bioengineered 'spider silk' we are not referencing an animal bi-product, but an ingredient that is engineered in a lab to mimic the qualities of 'spider silk'.</p><p>All of our products are 100% cruelty free and we're in the process of receiving our Leaping Bunny certification.</p>"
          }
        },
        "accordion_ExN4rA": {
          "type": "accordion",
          "settings": {
            "title": "Are your products fragrance free?",
            "description": "<p>Yes, all of our products are formulated without fragrance.</p>"
          }
        },
        "accordion_tUGLii": {
          "type": "accordion",
          "settings": {
            "title": "Do your products contain nano-particles?",
            "description": "<p>No, all Freaks of Nature products are proudly made with non-nano particles.</p>"
          }
        },
        "accordion_6YWdhk": {
          "type": "accordion",
          "settings": {
            "title": "What are 'bio-based' ingredients?",
            "description": "<p>'Bio-based' ingredients are ingredients derived from natural sources such as plants, minerals, and microorganisms. These are an alternative to synthetic or fossil based ingredients. If you have any questions about a specific ingredient, please review our ingredient page.</p>"
          }
        },
        "accordion_ne9TW3": {
          "type": "accordion",
          "settings": {
            "title": "What skin types are Freaks of Nature products suitable for?",
            "description": "<p>Freaks of Nature products are proudly formulated for all skin types. All of our products are dermatologist tested for safety and all ingredients are deemed non-comedogenic. If you have any questions about a specific ingredient, please review our ingredient page. If you have any concerns, we recommend conducting a patch test or sharing our ingredient list with your healthcare provider.</p>"
          }
        },
        "accordion_3TrD7z": {
          "type": "accordion",
          "settings": {
            "title": "Are Freaks of Nature products safe to use while pregnant / breastfeeding?",
            "description": "<p>Nothing in our formulas has been identified as unsafe for pregnant or breastfeeding persons and we adhere to all mandatory guidelines to ensure the safety of our products. If you have concerns we recommend you consult with your physician.</p>"
          }
        },
        "accordion_TNhCia": {
          "type": "accordion",
          "settings": {
            "title": "Can I use Freaks of Nature on my children?",
            "description": "<p>Yes, all of our products are 100% mineral sunscreens and safe enough for your children. If you have a child 6 months or younger please consult with a physician.</p>"
          }
        },
        "accordion_J6kGzA": {
          "type": "accordion",
          "settings": {
            "title": "Do your products expire?",
            "description": "<p>Expiration dates are printed on the bottom of our SPF products and expire within 36 months. We recommend all products be used 6 months after opening to maintain freshness and efficacy.</p>"
          }
        },
        "accordion_9b7gMe": {
          "type": "accordion",
          "settings": {
            "title": "Are Freaks of Nature products clean?",
            "description": "<p>Freaks of Nature products are formulated with the highest standards. Though we are direct-to-consumer, our ingredient lists are in line with clean standards specified by third-party retailers such as Credo and Wholefoods standards.</p>"
          }
        },
        "accordion_ByCeTL": {
          "type": "accordion",
          "settings": {
            "title": "What ingredients does Freaks of Nature not formulate with?",
            "description": "<p>Freaks of Nature does not formulate with chemicals UV filters, parabens, PEGS, phthalates, silicones, petrolatum, synthetic fragrances, sulfates, phosphates or formaldehyde.</p>"
          }
        },
        "accordion_gDxPmi": {
          "type": "accordion",
          "settings": {
            "title": "Are your products Reef Safe?",
            "description": "<p>Yes, our products are Hawaii Reef Compliant Act 104.</p>"
          }
        },
        "accordion_aPAaKz": {
          "type": "accordion",
          "settings": {
            "title": "Is your packaging recyclable?",
            "description": "<p>Yes, our packaging is a mono-material, made from 100% recycled Oceanworks plastics. Please recycle our bottles with like material.</p>"
          }
        }
      },

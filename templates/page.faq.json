    "faqs_qQPXpV": {
      "type": "faqs",
      "blocks": {
        "accordion_bGgt77": {
          "type": "accordion",
          "settings": {
            "title": "How can I check the status of my order?",
            "description": "<p>Navigate to the account section, sign in and click orders. You will be able to see tracking numbers for each order that has shipped. After placing an order you will also receive an email with tracking.</p>"
          }
        },
        "accordion_aTAmxi": {
          "type": "accordion",
          "settings": {
            "title": "How can I make changes to my order?",
            "description": "<p>We aim to process orders at our fulfillment center as quickly as possible so we cannot guarantee we will be able to make a change to an order after it has been placed. If you'd like to make a change to your order please email <a href=\"mailto:hi@freaksofnature.com\"><span style=\"text-decoration:underline\">hi@freaksofnature.com</span></a> with your order number and the details of the change and we will do our best to accommodate.</p>"
          }
        },
        "accordion_FybDa9": {
          "type": "accordion",
          "settings": {
            "title": "Which payment methods do you accept?",
            "description": "<p>We accept all major credit cards (American Express, Discover, MasterCard and Visa), PayPal and Apple Pay.</p>"
          }
        },
        "accordion_hHMWW7": {
          "type": "accordion",
          "settings": {
            "title": "When will my credit card be charged?",
            "description": "<p>Your credit card will be charged as soon as the order is processed.</p>"
          }
        },
        "accordion_yFNDTr": {
          "type": "accordion",
          "settings": {
            "title": "What should I do if I receive a damaged item or an item is missing?",
            "description": "<p>If you receive a damaged or missing item, we apologize! Please take a picture of the package within 48 hours and reach out to <a href=\"mailto:hi@freaksofnature.com\"><span style=\"text-decoration:underline\">hi@freaksofnature.com</span></a> or +1 (888) 272-9391 with your order number and the details. We will work to resolve the issue immediately. </p>"
          }
        }
      },

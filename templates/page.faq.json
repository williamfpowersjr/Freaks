      "type": "text-divider",
      "settings": {
        "text": "<p>Have a question that is not answered below? Reach out to <a href=\"mailto:hi@freaksofnature.com\" title=\"mailto:hi@freaksofnature.com\">hi@freaksofnature.com</a> and we will get back to you.</p>",

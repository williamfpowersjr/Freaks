          }
        },
        "card_46jfgR": {
          "type": "card",
          "settings": {
            "text": "<ul><li>We formulate with vegan Squalane derived from sugarcane, where as traditional squalene comes from shark livers - harming hundreds of thousands of sharks each year. </li><li><strong>Our vegan, bio-based formula supports a healthy skin microbiome while leaving your skin silky smooth.</strong></li></ul>",
            "tag_thumbnail_1": "shopify://shop_images/Screenshot_2024-05-04_at_6.27.23_PM.png",
            "tag_1": "Neossance™ Squalane Vegan Shark Lipid",
            "tag_2": "",
            "tag_3": ""
          }
        },
        "card_CznQTH": {
          "type": "card",
          "settings": {
            "text": "<ul><li>The closest thing to the fountain of youth that we could find. </li><li><strong>This powerful ingredient restores skin elasticity and moisture resulting in visibly plumper, firmer, and healthier looking skin. Plus, it aids your body’s natural collagen production. </strong></li></ul>",
            "tag_thumbnail_1": "shopify://shop_images/Padina_Pavonica_Thallus.jpg",
            "tag_1": "Padinami™ Brown Algae Extract",
            "tag_2": "",
            "tag_3": ""

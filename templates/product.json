        "card_6CDVCR": {
          "type": "card",
          "settings": {
            "text": "<ul><li>We formulate with vegan Squalane derived from sugarcane, where as traditional squalene comes from shark livers - harming hundreds of thousands of sharks each year.</li><li>Our vegan, bio-based formula supports a healthy skin microbiome while leaving your skin silky smooth.</li></ul>",
            "tag_thumbnail_1": "shopify://shop_images/squalane.jpg",
            "tag_1": "Squalane",
            "tag_2": "",
            "tag_3": ""
          }
        },
        "card_3kKFQ9": {
          "type": "card",
          "settings": {
            "text": "<ul><li>Hate to break it to you, but up to 83% of sunscreens use microplastics to help with water resistance.</li><li>HydroSeal, on the other hand, is plant based but supports water resistance so you can catch waves longer. </li></ul>",
            "tag_thumbnail_1": "shopify://shop_images/Screenshot_2025-05-28_at_7.36.37_PM.png",
            "tag_1": "HydroSeal",
            "tag_2": "",
            "tag_3": ""

        "card_4XJCrn": {
          "type": "card",
          "settings": {
            "text": "<ul><li>B-Silk is a groundbreaking vegan, biodegradable silk protein made from plant-based sources—no spiders harmed!</li><li><strong>It helps strengthen skin, improve elasticity, and protect against environmental stressors.</strong></li></ul>",

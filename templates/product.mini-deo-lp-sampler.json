    "lp_why": {
      "type": "lp-why",
      "blocks": {
        "ingredient_zinc": {
          "type": "ingredient",
          "settings": {
            "name": "Zinc Ricinoleate",
            "role": "Traps odor",
            "text": "Derived from castor oil. It traps odor compounds and neutralizes them without disrupting your skin’s microbiome.",
            "image": "shopify://shop_images/Ingredients_V2_6cb759eb-e242-4101-998a-b23b2e03c8bf.jpg"
          }
        },
        "ingredient_sinodor": {
          "type": "ingredient",
          "settings": {
            "name": "Sinodor",
            "role": "Removes odor",
            "text": "Targets and binds to malodor molecules. Instead of masking odor, it removes it, so good bacteria can thrive.",
            "image": "shopify://shop_images/Sinodor.jpg"
          }
        },
        "ingredient_smart": {
          "type": "ingredient",
          "settings": {
            "name": "SMA’RT TEC",
            "role": "Stops odor forming",
            "text": "Disrupts the enzyme activity that turns sweat into body odor. No need to block sweat.",
            "image": "shopify://shop_images/SMA_RT_TEC.jpg"
          }
        }
      },
      "block_order": [
        "ingredient_zinc",
        "ingredient_sinodor",
        "ingredient_smart"
      ],
      "settings": {
        "eyebrow": "Under every scent",
        "heading": "Every scent stops odor at the source.",
        "text": "<p>Every scent works with your microbiome to stop odor at the source. Odor-causing bacteria are kept at bay. The good bacteria that keep your skin healthy are left to thrive.</p>",
        "proof": "48-hour odor protection. Zero aluminum. Zero baking soda.",
        "quote": "I'm pretty picky about scents but I gotta say, they nailed both of them. Sophisticated, not overpowering. Odor protection works as promised, which is pretty uncommon for a natural deo.",
        "quote_name": "Mitchell A.",
        "cta": "Try all four for {price}"
      }
    },
    "lp_reviews": {
      "type": "lp-reviews",
      "blocks": {
        "review_julia": {
          "type": "review",
          "settings": {
            "title": "Best smelling deo!",
            "quote": "Obsessed with this scent and texture! I have gone through so many deodorants finally one that works and is enjoyable to use.",
            "name": "Julia N."
          }
        },
        "review_sean": {
          "type": "review",
          "settings": {
            "title": "Worth it",
            "quote": "Lovely scent on this one. As far as the feeling goes... I quickly forget I even applied it",
            "name": "Sean S."
          }
        },
        "review_douglas": {
          "type": "review",
          "settings": {
            "title": "",
            "quote": "Love the scent and most importantly it works. Great deodorant",
            "name": "Douglas D."
          }
        },
        "review_aj": {
          "type": "review",
          "settings": {
            "title": "",
            "quote": "Been trying out this deodorant for last couple days and I’m impressed. Stays on during workouts and the scent is subtle but good.",
            "name": "AJ F."
          }
        },
        "review_drew": {
          "type": "review",
          "settings": {
            "title": "Great smell. Clean Ingredients",
            "quote": "Smell is great. I can't believe how long it last. Love the clean ingredients most of all",
            "name": "Drew H."
          }
        }
      },
      "block_order": [
        "review_julia",
        "review_sean",
        "review_douglas",
        "review_aj",
        "review_drew"
      ],
      "settings": {
        "heading": "People keep mentioning the smell.",
        "show_rating": true,

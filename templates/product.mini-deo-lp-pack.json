    "lp_reviews": {
      "type": "lp-reviews",
      "blocks": {
        "review_alyse": {
          "type": "review",
          "settings": {
            "title": "Best deodorant ever!",
            "quote": "Wow it smells incredible and works better than any clean deodorant I’ve ever tried. Actually, it works better than any deodorant I’ve ever tried period. Clean or not!",
            "name": "Alyse B."
          }
        },
        "review_josh": {
          "type": "review",
          "settings": {
            "title": "Worth every penny",
            "quote": "I've tried a few natural deodorants, but they either don't work or irritate my skin. This one actually works, feels good, and I love the smell. Definitely my new go-to.",
            "name": "Josh B."
          }
        },
        "review_kristin": {
          "type": "review",
          "settings": {
            "title": "Lightweight, Effective, and No Residue",
            "quote": "I’ve tried a dozen different clean deodorants, and most of them end up being cakey and thick, leaving residue on my clothes - or they just don’t work. Freaks is lightweight, doesn’t leave any residue, and actually keeps odor under control.",
            "name": "Kristin P."
          }
        },
        "review_calvin": {
          "type": "review",
          "settings": {
            "title": "Checks all the boxes",
            "quote": "Love the deodorant. Smells great, lasts long, clean. Been looking for a while for one that checks all the boxes I care about.",
            "name": "Calvin S."
          }
        },
        "review_maggie": {
          "type": "review",
          "settings": {
            "title": "Love!!",
            "quote": "Love this deo!! One of the only natural ones I've used that continues to work.",
            "name": "Maggie R."
          }
        }
      },
      "block_order": [
        "review_alyse",

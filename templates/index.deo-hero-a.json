    "values_8U6Dea": {
      "type": "values",
      "blocks": {
        "value_QzmLzj": {
          "type": "value",
          "settings": {
            "title": "You go hard. So do we. ",
            "description": "Our skin is severely at risk. From environmental pollutants and harsh elements–the skincare systems out there aren’t cutting it. So, we made one that did. Whether you’re running an ultra marathon or just keeping up with the daily sprint of life, our products protect, repair, and strengthen your skin. "
          }
        },
        "value_JhnBXe": {
          "type": "value",
          "settings": {
            "title": "Clean",
            "description": "0 chemical filters. 0 SPF boosters. 0 microplastics. Just 100% mineral, bio-based ingredients that feel good on you and you can feel good about. "
          }
        },
        "value_XpNDrF": {
          "type": "value",
          "settings": {
            "title": "Clinically proven, science backed innovation",
            "description": "Since inception, we’ve worked with leading scientists  to develop formulas that not only protect, but also strengthen and repair your skin. "
          }
        },
        "value_Wi7pUz": {
          "type": "value",
          "settings": {
            "title": "Freaks about nature ",
            "description": "All of our products are reef-safe, vegan, non chemical and made for all skin types. Our bottles feature the first ever airless pump made of 100% recycled plastic. For every order, we remove 5 lbs of plastic from our oceans in partnership with Oceanworks."
          }
        }
      },
      "block_order": [
        "value_QzmLzj",

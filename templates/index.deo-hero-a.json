    "press_hKhhYf": {
      "type": "press",
      "blocks": {
        "quote_fNC4VQ": {
          "type": "quote",
          "settings": {
            "text": "This is easily one of the most effective, natural-leaning, and unique deodorants you can buy right now. It kept me smelling fresh and mostly dry all day, and I found myself looking forward to applying.",
            "logo": "shopify://shop_images/MJLogo_black_1.jpg",
            "author": "",
            "verified": false
          }
        },
        "quote_Wff7CN": {
          "type": "quote",
          "settings": {
            "text": "An ideal choice for busy professionals looking for a reliable deodorant that can keep odor and sweat at bay during high-pressure presentations and can also be applied quickly before running out the door.",
            "logo": "shopify://shop_images/FORTUNE-LOGO-2016.png",
            "author": "",
            "verified": false
          }
        },
        "quote_zgjDLk": {
          "type": "quote",
          "settings": {
            "text": "I’ve tried a dozen different clean deodorants, and most of them end up being cakey and thick, leaving residue on my clothes - or they just don’t work. Freaks is lightweight, doesn’t leave any residue, and actually keeps odor under control.",
            "author": "Kristin P",
            "verified": true
          }
        }

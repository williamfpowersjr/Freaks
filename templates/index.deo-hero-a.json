        "influencer_TWrqhF": {
          "type": "influencer",
          "settings": {
            "video": "shopify://files/videos/max.mp4",
            "mobile_video": "shopify://files/videos/max.mp4",
            "title": "Max Jolliffe",
            "badge": "Ultrarunner",
            "info_text": "\"I spend the majority of my life running, surfing, and enjoying time outside, so using clean and natural products is everything to me,\" says Jolliffe. \"Being a freak means pushing yourself to the extreme without fear, and having Kelly Slater in your corner while you do it doesn't hurt either.\""
          }
        },
        "influencer_MYt3Um": {
          "type": "influencer",
          "settings": {
            "video": "shopify://files/videos/BettyLou-GoldCoast-TRIMMED_COMPRESSED.mp4",
            "mobile_video": "shopify://files/videos/BettyLou-GoldCoast-TRIMMED_COMPRESSED.mp4",
            "title": "Bettylou Sakura",
            "badge": "Surfer",
            "info_text": "\"Being a freak means going for everything with your heart and no fear, that shows up in my career every single day. Freaks of Nature reflects the way I train and compete, and their commitment to peak performance is what makes me feel truly connected.\""
          }
        }
      },

        "text_RFtjr7": {
          "type": "text",
          "settings": {
            "text": "<p>The Peak Performance Sun Stick is Hawaii Act 104 compliant, 100% biodegradable and reef safe. Because when the ocean is your office what you leave in it matters as much as what you put on your skin.</p>"

        "text_6b8whL": {
          "type": "text",
          "settings": {
            "text": "<p>The Peak Performance Sun Stick is water resistant for 80 minutes with a lightweight formula that stays put without feeling heavy or greasy. Built for the people who spend more time in the water than out of it.</p>"

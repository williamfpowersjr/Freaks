    "ctr_landing_reason_dhtnJ4": {
      "type": "ctr-landing-reason",
      "blocks": {
        "text_Y4aHYn": {
          "type": "text",
          "settings": {
            "text": "<p>Water resistance matters more than most brands admit. Most sunscreens lose efficacy the moment they hit water and the FDA only requires a minimum of 40 minutes for a water resistant claim. If you're surfing, swimming or training in the heat that's simply not enough.</p>"

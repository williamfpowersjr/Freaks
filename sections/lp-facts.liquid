{%- comment -%}
  LP (variety pack): a "facts" label in the style of a food label, next to a short how-it-works list.
  Every row must be a claim the live product page already makes.
{%- endcomment -%}
{{ 'lp-mini-deo.css' | asset_url | stylesheet_tag }}
{{ 'lp-pack.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign lp_rows = section.blocks | where: 'type', 'row'
  assign lp_steps = section.blocks | where: 'type', 'step'
-%}

<div class="lp-facts">
  <div class="lp-wrap">
    <div class="lp-head">
      {% if section.settings.eyebrow != blank %}
        <p class="lp-eyebrow lp-eyebrow--pill">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="lp-h2">{{ section.settings.heading }}</h2>
    </div>

    <div class="lp-facts__grid">
      <div class="lp-label">
        <p class="lp-label__title">{{ section.settings.label_title }}</p>
        {% if section.settings.label_line_1 != blank %}
          <p class="lp-label__line">{{ section.settings.label_line_1 }}</p>
        {% endif %}
        {% if section.settings.label_line_2 != blank %}
          <p class="lp-label__line lp-label__line--strong">{{ section.settings.label_line_2 }}</p>
        {% endif %}
        <dl class="lp-label__rows">
          {% for block in lp_rows %}
            <div class="lp-label__row" {{ block.shopify_attributes }}>
              <dt>{{ block.settings.label }}</dt>
              <dd>{{ block.settings.value }}</dd>
            </div>
          {% endfor %}
        </dl>
        {% if section.settings.label_footnote != blank %}
          <p class="lp-label__footnote">{{ section.settings.label_footnote }}</p>
        {% endif %}
      </div>

      <div class="lp-card lp-facts__how">
        {% if section.settings.how_heading != blank %}
          <h3 class="lp-facts__how-heading">{{ section.settings.how_heading }}</h3>
        {% endif %}
        {% if section.settings.how_text != blank %}
          <p class="lp-facts__how-text">{{ section.settings.how_text }}</p>
        {% endif %}
        {% if lp_steps.size > 0 %}
          <ol class="lp-facts__steps">
            {% for block in lp_steps %}
              <li {{ block.shopify_attributes }}>
                <span class="lp-facts__num">0{{ forloop.index }}</span>
                <p>
                  <strong>{{ block.settings.name }}</strong>
                  {{ block.settings.text }}
                </p>
              </li>
            {% endfor %}
          </ol>
        {% endif %}
      </div>
    </div>

    {% render 'lp-cta', text: section.settings.cta, product: product, variant: 'cobalt' %}
  </div>
</div>

{% schema %}
{
  "name": "LP Facts label",
  "tag": "section",
  "class": "lp-section lp-facts-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Only add rows the live product page already claims."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What's in it"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Read the label."
    },
    {
      "type": "header",
      "content": "Label"
    },
    {
      "type": "text",
      "id": "label_title",
      "label": "Label title",
      "default": "Deodorant Facts"
    },
    {
      "type": "text",
      "id": "label_line_1",
      "label": "Line 1",
      "default": "4 minis per pack"
    },
    {
      "type": "text",
      "id": "label_line_2",
      "label": "Line 2",
      "default": "Serving size: 1 mini (about a week)"
    },
    {
      "type": "textarea",
      "id": "label_footnote",
      "label": "Footnote"
    },
    {
      "type": "header",
      "content": "How it works"
    },
    {
      "type": "text",
      "id": "how_heading",
      "label": "Heading",
      "default": "Stops odor at the source."
    },
    {
      "type": "textarea",
      "id": "how_text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Button text",
      "info": "{price} shows the live price. Leave empty to hide.",
      "default": "Get the pack for {price}"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Label row",
      "limit": 10,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Name",
          "default": "Aluminum"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "0"
        }
      ]
    },
    {
      "type": "step",
      "name": "How it works step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient",
          "default": "Zinc Ricinoleate"
        },
        {
          "type": "text",
          "id": "text",
          "label": "What it does"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP Facts label"
    }
  ]
}
{% endschema %}

{% comment %}
  Password gate for a single template.
  - client mode: only the SHA-256 of the password is rendered and JS hides the page. Easy to bypass.
  - server mode: the passcode is saved to the cart attribute "_pwg" and checked here in Liquid.
    While locked, this section prints <!--ctr-pwg:locked--> and layout/theme.liquid sends only the
    gate (between the start/end markers) instead of the page, so the content never leaves the server.
{% endcomment %}
{%- liquid
  assign show_gate = false
  if section.settings.enabled and section.settings.password != blank
    if request.design_mode == false or section.settings.preview_in_editor
      assign show_gate = true
    endif
  endif

  assign server_mode = false
  if section.settings.mode == 'server'
    # The layout only swaps the page on templates listed in theme settings; otherwise fall back to browser mode.
    assign ctr_pwg_templates = settings.ctr_pwg_templates | remove: ' ' | split: ','
    if template.suffix != blank and ctr_pwg_templates contains template.suffix
      assign server_mode = true
    endif
  endif

  if show_gate and server_mode
    assign typed = cart.attributes._pwg | default: '' | strip
    assign expected = section.settings.password | strip
    if typed == expected
      assign show_gate = false
      assign server_unlocked = true
    endif
  endif
-%}
{%- if server_unlocked -%}
  {%- comment -%} Clears the "wrong passcode" flag so it can't show up later if the cart expires. {%- endcomment -%}
  <script>
    try {
      sessionStorage.removeItem('ctr-pwg-{{ template.suffix | default: template.name }}-tried');
    } catch (error) {}
  </script>
{%- endif -%}
{%- if show_gate -%}
  {%- if server_mode and request.design_mode == false -%}<!--ctr-pwg:locked--><!--ctr-pwg:start-->{%- endif -%}
  {{ 'ctr-password-gate.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'ctr-password-gate.js' | asset_url }}" defer></script>

  <ctr-password-gate
    class="ctr-pwg"
    style="--ctr-pwg-bg: {{ section.settings.background_color }};"
    {% if server_mode %}
      data-mode="server"
    {% else %}
      data-hash="{{ section.settings.password | strip | sha256 }}"
    {% endif %}
    data-key="ctr-pwg-{{ template.suffix | default: template.name }}"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ctr-pwg-heading-{{ section.id }}"
  >
    <div class="ctr-pwg__card">
      {% if section.settings.image != blank %}
        <div class="ctr-pwg__media">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 1024px) 474px, calc(100vw - 82px)',
              alt: section.settings.image.alt,
              class: 'ctr-pwg__img'
          }}
        </div>
      {% endif %}
      <div class="ctr-pwg__content">
        <div class="ctr-pwg__head">
          {% if section.settings.badge != blank %}
            <span class="ctr-pwg__badge">{{ section.settings.badge }}</span>
          {% endif %}
          <h2 class="ctr-pwg__heading" id="ctr-pwg-heading-{{ section.id }}">
            <span class="ctr-pwg__heading-line">{{ section.settings.heading_line_1 }}</span>
            {% if section.settings.heading_line_2 != blank %}
              <span class="ctr-pwg__heading-line ctr-pwg__heading-line--accent">{{ section.settings.heading_line_2 }}</span>
            {% endif %}
          </h2>
        </div>
        <div class="ctr-pwg__body">
          {% if section.settings.text != blank %}
            <div class="ctr-pwg__text">{{ section.settings.text }}</div>
          {% endif %}
          <form class="ctr-pwg__form" novalidate>
            <label class="ctr-pwg__label" for="ctr-pwg-input-{{ section.id }}">{{ section.settings.placeholder }}</label>
            <input
              class="ctr-pwg__input"
              id="ctr-pwg-input-{{ section.id }}"
              type="password"
              name="password"
              autocomplete="off"
              placeholder="{{ section.settings.placeholder }}"
              required
            >
            <p class="ctr-pwg__error" role="alert" hidden>{{ section.settings.error }}</p>
            {% render 'buy-button',
              text: section.settings.button,
              type: 'submit',
              cta_color: 'blue',
              hasIcons: true,
              extra_classes: 'w-full ctr-pwg__button'
            %}
          </form>
        </div>
      </div>
    </div>
  </ctr-password-gate>
  {%- if server_mode and request.design_mode == false -%}<!--ctr-pwg:end-->{%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "CTR Password Gate",
  "tag": "section",
  "class": "ctr-password-gate-section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable password", "default": true },
    { "type": "text", "id": "password", "label": "Password", "info": "Case sensitive. Gate is off while empty." },
    {
      "type": "select",
      "id": "mode",
      "label": "Check passcode on",
      "options": [
        { "value": "client", "label": "Browser (simple, easy to bypass)" },
        { "value": "server", "label": "Server (page hidden until unlocked)" }
      ],
      "default": "client"
    },
    { "type": "checkbox", "id": "preview_in_editor", "label": "Preview in theme editor", "info": "Hidden in the editor by default so the page below stays editable.", "default": false },
    { "type": "header", "content": "Content" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "MEMBERS ONLY" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "The Deo Mini Kit." },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2 (accent)", "default": "You get it first." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Password" },
    { "type": "text", "id": "button", "label": "Button text", "default": "Unlock early access" },
    { "type": "text", "id": "error", "label": "Error message", "default": "Incorrect password. Please try again." },
    { "type": "color", "id": "background_color", "label": "Page background", "default": "#0032a0" }
  ],
  "presets": [{ "name": "CTR Password Gate" }]
}
{% endschema %}

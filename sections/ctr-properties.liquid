{{ 'ctr-properties.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ctr_properties_button_icon_classes = ''
  case section.settings.button_arrow_direction
    when 'top'
      assign ctr_properties_button_icon_classes = '-rotate-90'
    when 'down'
      assign ctr_properties_button_icon_classes = 'rotate-90'
  endcase
-%}

<style>
  #shopify-section-{{ section.id }} {
    .ctr-properties__title-wrap {
        {% if section.settings.title_size_mobile == 'small' %}
          font-size: clamp(24px, calc(24 * 1px + (50) * (100vw - 430 * 1px) / (1225)), 60px);
        {% elsif section.settings.title_size_mobile == 'medium' %}
          font-size: clamp(32px, calc(32 * 1px + (64) * (100vw - 430 * 1px) / (1225)), 74px);
        {% elsif section.settings.title_size_mobile == 'large' %}
          font-size: clamp(36px, calc(36 * 1px + (70) * (100vw - 430 * 1px) / (1225)), 96px);
        {% endif %}

        @media (min-width: 1024px) {
        {% if section.settings.title_size_desktop == 'small' %}
          font-size: clamp(40px, calc(40 * 1px + (50) * (100vw - 430 * 1px) / (1225)), 60px);
        {% elsif section.settings.title_size_desktop == 'medium' %}
          font-size: clamp(32px, calc(32 * 1px + (64) * (100vw - 430 * 1px) / (1225)), 74px);
        {% elsif section.settings.title_size_desktop == 'large' %}
          font-size: clamp(36px, calc(36 * 1px + (70) * (100vw - 430 * 1px) / (1225)), 96px);
        {% endif %}
      }
    }
  }
</style>

<div
  id="shopify-section-{{ section.id }}"
  class="ctr-properties{% if section.settings.items_layout == 'stats_row' %} ctr-properties--stats-row{% endif %}{% if section.settings.title_line_2 != blank %} ctr-properties--split-title{% endif %}"
  style="
    {% if section.settings.background_gradient != blank %}
      --ctr-properties-background: {{ section.settings.background_gradient }};
    {% else %}
    --ctr-properties-background: {{ section.settings.background }};
    {% endif %}
    --ctr-properties-card-background: {{ section.settings.card_background }};
    --ctr-properties-border-color: {{ section.settings.border_color }};
    --ctr-properties-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --ctr-properties-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --ctr-properties-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --ctr-properties-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --ctr-properties-content-gap: {{ section.settings.content_gap }}px;
  "
  data-section-id="{{ section.id }}"
>
  <div class="ctr-properties__container">
    <div class="ctr-properties__card">
      {% if section.settings.section_image != blank and section.settings.hide_mobile_image != true %}
        <div class="ctr-properties__media">
          <img
            src="{{ section.settings.section_image | img_url: "1600x" }}"
            alt="{{ section.settings.section_image.alt | escape }}"
            loading="lazy"
            class="ctr-properties__image"
            width="{{ section.settings.section_image.width }}"
            height="{{ section.settings.section_image.height }}"
          >
        </div>
      {% endif %}

      <div class="ctr-properties__content">
        {% if section.settings.title_line_2 != blank %}
          <div class="ctr-properties__title-wrap mb-[-1.5px] w-full overflow-hidden border-black/15 text-center font-neue">
            {% if section.settings.title != blank %}
              <div class="border-y border-black/15 lg:border-t">
                <h2 class="ctr-properties__title !-mb-3 -mb-[0.17rem] text-pretty pt-3 uppercase lg:!-mb-6 lg:-mb-4 lg:pt-5">
                  {{ section.settings.title }}
                </h2>
              </div>
            {% endif %}

            <div class="border-b border-black/15 font-neue">
              <h2
                class="ctr-properties__title !-mb-3 -mb-[0.17rem] text-pretty pt-3 uppercase lg:!-mb-6 lg:-mb-4 lg:pt-5"
                style="color: {{ section.settings.title_accent_color }};"
              >
                {{ section.settings.title_line_2 }}
              </h2>
            </div>
          </div>
        {% elsif section.settings.title != blank %}
          <div class="ctr-properties__title-wrap mb-[-1.5px] w-full overflow-hidden border-black/15 bg-grey-lines text-center font-neue">
            <h2 class="ctr-properties__title !-mb-3 -mb-[0.17rem] text-pretty pt-3 uppercase lg:!-mb-6 lg:-mb-4 lg:pt-5">
              {{ section.settings.title }}
            </h2>
          </div>
        {% endif %}
        {% if section.settings.section_text != blank %}
          <div class="ctr-properties__section-text inline-rich-text{% if section.settings.items_layout == 'stats_row' %}{% else %} fn-tt-sub-title-30{% endif %}">
            {{ section.settings.section_text }}
          </div>
        {% endif %}

        <div class="ctr-properties__body">
          {% if section.blocks.size > 0 %}
            <div class="ctr-properties__items">
              {% for block in section.blocks %}
                <article class="ctr-properties__item" {{ block.shopify_attributes }}>
                  <div class="ctr-properties__item-header">
                    {% if block.settings.icon != blank %}
                      <img
                        src="{{ block.settings.icon | img_url: '120x' }}"
                        alt="{{ block.settings.icon.alt | escape }}"
                        loading="lazy"
                        class="ctr-properties__item-icon"
                        width="{{ block.settings.icon.width }}"
                        height="{{ block.settings.icon.height }}"
                      >
                    {% endif %}

                    {% if block.settings.title != blank %}
                      <div class="ctr-properties__item-title inline-rich-text">
                        {{ block.settings.title }}
                      </div>
                    {% endif %}
                  </div>

                  {% if block.settings.text != blank %}
                    <div class="ctr-properties__item-text inline-rich-text">
                      {{ block.settings.text }}
                    </div>
                  {% endif %}
                </article>
              {% endfor %}
            </div>
          {% endif %}

          {% assign ctr_properties_button_text = section.settings.button_label | strip_html | strip %}
          {% if ctr_properties_button_text != blank %}
            {% if section.settings.button_link != blank %}
              {%- liquid
                assign ctr_properties_cta_attrs = ''
                if section.settings.button_open_new_tab
                  assign ctr_properties_cta_attrs = 'target="_blank" rel="noopener noreferrer"'
                endif
              -%}
              {% render 'cta',
                as: 'a',
                href: section.settings.button_link,
                text: ctr_properties_button_text,
                hasIcons: true,
                cta_color: section.settings.button_style,
                extra_classes: 'ctr-properties__button',
                extra_attributes: ctr_properties_cta_attrs,
                extra_icon_classes: ctr_properties_button_icon_classes
              %}
            {% else %}
              {% render 'cta',
                as: 'button',
                type: 'button',
                text: ctr_properties_button_text,
                hasIcons: true,
                cta_color: section.settings.button_style,
                extra_classes: 'ctr-properties__button',
                extra_icon_classes: ctr_properties_button_icon_classes
              %}
            {% endif %}
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Properties (CTR)",
  "tag": "section",
  "class": "ctr-properties-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What to expect"
    },
    {
      "type": "select",
      "id": "title_size_desktop",
      "label": "Title size desktop",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "title_size_mobile",
      "label": "Title size mobile",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "richtext",
      "id": "section_text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "section_image",
      "label": "Section image"
    },
    {
      "type": "checkbox",
      "id": "hide_mobile_image",
      "label": "Hide image on mobile",
      "default": false
    },
    {
      "type": "richtext",
      "id": "button_label",
      "label": "Button label",
      "default": "<p>Start my routine</p>"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "orange",
          "label": "Orange"
        }
      ],
      "default": "blue"
    },
    {
      "type": "select",
      "id": "button_arrow_direction",
      "label": "Button arrow direction",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "down",
          "label": "Down"
        }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Section background",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "background_gradient",
      "label": "Section background gradient",
      "info": "Example: linear-gradient(180deg, #FFFFFF 0%, #FFF2E9 100%)"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#F9F9F9"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "alpha": true,
      "default": "#d9d9d9"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content gap",
      "min": 8,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Ambassador / alternate layout"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title line 2",
      "info": "Optional second heading line below the main title. Enables split-title layout with bordered bands (no grey-lines background)."
    },
    {
      "type": "color",
      "id": "title_accent_color",
      "label": "Title line 2 color",
      "default": "#ff7815"
    },
    {
      "type": "select",
      "id": "items_layout",
      "label": "Items layout",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "stats_row",
          "label": "Stats row"
        }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "button_open_new_tab",
      "label": "Open button in new tab",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Property item (CTR)",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "richtext",
          "id": "title",
          "label": "Title",
          "default": "<p>Good for</p>"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>All skin types.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Properties (CTR)",
      "category": "CTR Sections",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item",
          "settings": {
            "title": "<p>Tastes like</p>",
            "text": "<p>Tangy passionfruit, guava, and a hint of zesty lime.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "<p>Color & Texture</p>",
            "text": "<p>Starts as a sand-colored powder that turns to warm, light pink depending on water concentration.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "<p>Performance</p>",
            "text": "<p>Designed to support electrolyte balance while promoting skin vitality and a healthy gut microbiome. Perfect before or after workouts, or anytime you need elevated hydration support.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

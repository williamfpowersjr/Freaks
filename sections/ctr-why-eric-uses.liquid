{{ 'ctr-why-eric-uses.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ctr_why_eric_uses_button_link = section.settings.button_link | default: '#'
  assign ctr_why_eric_uses_button_icon_classes = ''
  case section.settings.button_arrow_direction
    when 'top'
      assign ctr_why_eric_uses_button_icon_classes = '-rotate-90'
    when 'down'
      assign ctr_why_eric_uses_button_icon_classes = 'rotate-90'
  endcase
-%}

<div
  id="shopify-section-{{ section.id }}"
  class="ctr-why-eric-uses{% if section.settings.enable_border_top %} ctr-why-eric-uses--border-top{% endif %}{% if section.settings.enable_border_bottom %} ctr-why-eric-uses--border-bottom{% endif %}"
  style="
    --ctr-why-eric-uses-bg: {% if section.settings.background_gradient != blank %}{{ section.settings.background_gradient }}{% else %}{{ section.settings.background_color }}{% endif %};
    --ctr-why-eric-uses-heading-color: {{ section.settings.heading_color }};
    --ctr-why-eric-uses-text-color: {{ section.settings.text_color }};
    --ctr-why-eric-uses-body-color: {{ section.settings.body_color }};
    --ctr-why-eric-uses-border-color: {{ section.settings.border_color }};
    --ctr-why-eric-uses-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --ctr-why-eric-uses-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --ctr-why-eric-uses-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --ctr-why-eric-uses-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="ctr-why-eric-uses__wrapper">
    <div class="ctr-why-eric-uses__inner">
      {% if section.settings.title != blank %}
        <div class="ctr-why-eric-uses__title ctr-why-eric-uses__title--mobile bg-grey-lines">
          {{ section.settings.title }}
        </div>
      {% endif %}

      {% if section.settings.video != blank or section.settings.image != blank %}
        <div class="ctr-why-eric-uses__media">
          <div class="ctr-why-eric-uses__media-inner">
            <div class="ctr-why-eric-uses__media-frame">
              {% if section.settings.video != blank %}
                <video-element class="ctr-why-eric-uses__video block h-full w-full">
                  <div class="group relative h-full w-full overflow-hidden">
                    {% render 'lazy-video',
                      video: section.settings.video,
                      class: 'ctr-why-eric-uses__video-element',
                      autoplay: false,
                      muted: true,
                      loop: true
                    %}

                    {% if section.settings.show_video_controls %}
                      <div class="ctr-why-eric-uses__video-ui">
                        <div class="ctr-why-eric-uses__play-controls">
                          <button
                            type="button"
                            aria-label="Pause video"
                            data-video-pause
                            class="ctr-why-eric-uses__control-btn hidden"
                          >
                            <svg
                              class="ctr-why-eric-uses__control-icon"
                              stroke="currentColor"
                              fill="currentColor"
                              stroke-width="0"
                              viewBox="0 0 16 16"
                              aria-hidden="true"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5m5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5"></path>
                            </svg>
                          </button>
                          <button
                            type="button"
                            aria-label="Play video"
                            data-video-play
                            class="ctr-why-eric-uses__control-btn"
                          >
                            <svg
                              class="ctr-why-eric-uses__control-icon"
                              stroke="currentColor"
                              fill="currentColor"
                              stroke-width="0"
                              viewBox="0 0 16 16"
                              aria-hidden="true"
                              xmlns="http://www.w3.org/2000/svg"
                            >
                              <path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393"></path>
                            </svg>
                          </button>
                        </div>
                        <div class="ctr-why-eric-uses__mute-controls">
                          {% render 'video-controls', icons_class: '', hide_control: true, autopause: false %}
                        </div>
                      </div>
                    {% endif %}
                  </div>
                </video-element>
              {% elsif section.settings.image != blank %}
                <img
                  class="ctr-why-eric-uses__image"
                  src="{{ section.settings.image | img_url: '1200x' }}"
                  alt="{{ section.settings.image.alt | escape }}"
                  loading="lazy"
                  width="{{ section.settings.image.width }}"
                  height="{{ section.settings.image.height }}"
                >
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}

      <div class="ctr-why-eric-uses__content">
        {% if section.settings.title != blank %}
          <div class="ctr-why-eric-uses__title ctr-why-eric-uses__title--desktop bg-grey-lines">
            {{ section.settings.title }}
          </div>
        {% endif %}

        {% if section.settings.text != blank
          or section.settings.quote != blank
          or section.settings.attribution != blank
        %}
          <div class="ctr-why-eric-uses__copy">
            {% if section.settings.text != blank %}
              <div class="ctr-why-eric-uses__text">
                {{ section.settings.text }}
              </div>
            {% endif %}

            {% if section.settings.quote != blank %}
              <div class="ctr-why-eric-uses__quote">
                {{ section.settings.quote }}
              </div>
            {% endif %}

            {% if section.settings.attribution != blank %}
              <div class="ctr-why-eric-uses__attribution">
                {{ section.settings.attribution }}
              </div>
            {% endif %}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank %}
          <a
            class="ctr-why-eric-uses__button-wrap"
            href="{{ ctr_why_eric_uses_button_link }}"
            {% if section.settings.button_open_new_tab %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            {% render 'cta',
              as: 'button',
              text: section.settings.button_label,
              hasIcons: true,
              cta_color: section.settings.button_style,
              extra_classes: 'ctr-why-eric-uses__button',
              extra_icon_classes: ctr_why_eric_uses_button_icon_classes
            %}
          </a>

          <a
            class="ctr-why-eric-uses__button-wrap ctr-why-eric-uses__button-wrap--mobile"
            href="{{ ctr_why_eric_uses_button_link }}"
            {% if section.settings.button_open_new_tab %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            {% render 'cta',
              as: 'button',
              text: section.settings.button_label,
              hasIcons: true,
              cta_color: section.settings.button_style,
              extra_classes: 'ctr-why-eric-uses__button w-full',
              extra_icon_classes: ctr_why_eric_uses_button_icon_classes
            %}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Why Eric Uses (CTR)",
  "tag": "section",
  "class": "ctr-why-eric-uses-section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Used when no video is set."
    },
    {
      "type": "checkbox",
      "id": "show_video_controls",
      "label": "Show video controls",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>why eric uses</p><p>freaks of nature</p>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Eric is a 5× Ironman finisher and hybrid athlete who trains outdoors daily. He needs a clean deodorant that actually keeps up.</p>"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Quote",
      "default": "<p>“This is the best deodorant I've tried. It smells great and lasts for days. If I’m putting on deodorant, it’s going to be Freaks of Nature.”</p>"
    },
    {
      "type": "richtext",
      "id": "attribution",
      "label": "Attribution",
      "default": "<p>—Eric Hinman</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_open_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "blue", "label": "Blue" },
        { "value": "orange", "label": "Orange" },
        { "value": "black", "label": "Black" },
        { "value": "white", "label": "White" }
      ],
      "default": "blue"
    },
    {
      "type": "select",
      "id": "button_arrow_direction",
      "label": "Button arrow direction",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "top", "label": "Top" },
        { "value": "down", "label": "Down" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F9F9F9"
    },
    {
      "type": "text",
      "id": "background_gradient",
      "label": "Background gradient",
      "info": "Optional. Example: linear-gradient(180deg, #FFF 0%, #FFF2E9 100%). Overrides background color when set."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#212121"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#212121"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "enable_border_top",
      "label": "Enable top border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_border_bottom",
      "label": "Enable bottom border",
      "default": false
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "alpha": true,
      "default": "#22202F29"
    },
    {
      "type": "header",
      "content": "Padding desktop"
    },
    {
      "type": "number",
      "id": "padding_top_desktop",
      "label": "Padding top desktop",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom desktop",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding mobile"
    },
    {
      "type": "number",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "default": 0
    },
    {
      "type": "number",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Why Eric Uses (CTR)",
      "category": "CTR Sections"
    }
  ]
}
{% endschema %}

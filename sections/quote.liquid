{% schema %}
{
  "name": "Quote",
  "tag": "section",
  "class": "quote-section",
  "presets": [
    {
      "name": "Quote",
      "category": "Quote",
      "settings": {
        "bg_color": "bg-white",
        "text": "Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua.",
        "signature": "shopify:\/\/shop_images\/Kelly_Slater_Signature.svg",
        "author": "Lorem ipsum",
        "description": "Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua."
      }
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "bg_color",
      "label": "Background Color",
      "options": [
        {
          "value": "bg-white",
          "label": "White"
        },
        {
          "value": "bg-offWhite",
          "label": "Off White"
        }
      ],
      "default": "bg-white"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "signature",
      "label": "Signature"
    },

    {
      "type": "text",
      "id": "author",
      "label": "Author"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    }
  ]
}
{% endschema %}
<scroll-animated-text-element>
  <div class="{{ section.settings.bg_color }}" data-scroll-animated-text>
    <div
      class="flex items-center overflow-hidden border-t border-black/15 "
      style="inset-block-start: 0;"
    >
      <div
        data-section-inner
        class="px-24 py-64 lg:p-128"
      >
        <div class="flex h-full flex-col justify-between lg:gap-128">
          <div class="relative flex flex-col gap-152 lg:gap-128">
            <div class="relative">
              <blockquote class="fn-tt-title-50 opacity-0">
                {{ section.settings.text }}
              </blockquote>
              <p
                data-text-bottom
                aria-hidden="true"
                class="fn-tt-title-50 absolute left-0 top-0 w-full transition-opacity duration-300 ease-in-out"
              >
                {{ section.settings.text }}
              </p>
              <p
                data-text-top
                aria-hidden="true"
                class="fn-tt-title-50 w-fulltransition-opacity absolute left-0 top-0 opacity-0 duration-300 ease-in-out"
              >
                {{ section.settings.text }}
              </p>
            </div>
          </div>

          <div class="relative flex w-full flex-col items-center justify-between md:flex-row lg:justify-start">
            {% if section.settings.signature != blank %}
              <div class="-m-10 w-[70vw] md:relative lg:bottom-0 lg:w-fit">
                {{
                  section.settings.signature
                  | image_url: width: section.settings.signature.width
                  | image_tag:
                    loading: 'lazy',
                    sizes: '(min-width: 1024px) 25vw, 50vw',
                    class: 'w-full h-fit md:w-fit max-h-224'
                }}
              </div>
            {% endif %}
            <div class="flex w-full justify-between lg:w-fit lg:justify-start">
              <p class="fn-tt-body-20 w-1/2 lg:w-fit lg:min-w-248">{{ section.settings.author }}</p>
              <p class="fn-tt-body-20 w-1/2 lg:w-fit">{{ section.settings.description }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</scroll-animated-text-element>

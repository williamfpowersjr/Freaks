<div class="relative flex w-full overflow-hidden pb-32 lg:flex lg:justify-end lg:px-40 lg:pb-112 {{ section.settings.bg_color }} {{ section.settings.lg_bg_color }} ">
  <div class="relative overflow-hidden lg:w-3/4">
    {% render 'causes', blocks: section.blocks, card_bg_color: section.settings.card_bg_color %}
    {% if section.settings.cta != blank %}
      <div class="lg:w-full">
        {% render 'cta',
          as: 'a',
          text: section.settings.cta,
          extra_classes: 'w-full',
          hasIcons: true,
          cta_color: section.settings.cta_color,
          href: section.settings.cta_url
        %}
      </div>
    {% endif %}
  </div>
</div>

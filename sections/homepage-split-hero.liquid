{% schema %}
{
  "name": "Homepage Split Hero",
  "tag": "section",
  "class": "homepage-split-hero-section",
  "presets": [
    {
      "name": "Homepage Split Hero",
      "category": "Homepage Split Hero",
      "settings": {
        "image": "shopify://shop_images/02_SLATER_1149_rt2_1a574b68-3a9d-4a6f-86d9-dfc3cca4cce8.jpg",
        "title": "Lorem ipsum",
        "section_height": "height_60"
      },
      "blocks": [
        {
          "type": "cta",
          "settings": {
            "cta_text": "Lorem ipsum",
            "cta_link": "#",
            "cta_color": "orange"
          }
        },
        {
          "type": "cta",
          "settings": {
            "cta_text": "Lorem ipsum",
            "cta_link": "#",
            "cta_color": "blue"
          }
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "If you want to have a still image, leave the video fields blank."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Preview Video",
      "info": "This video is going to loop in the index page hero."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "options": [
        {
          "value": "height_60",
          "label": "60%"
        },
        {
          "value": "height_80",
          "label": "80%"
        },
        {
          "value": "height_100",
          "label": "100%"
        }
      ],
      "default": "height_60"
    }
  ],
  "blocks": [
    {
      "type": "cta",
      "name": "Cta",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "cta_text",
          "label": "Cta Text"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Cta Link"
        },
        {
          "type": "select",
          "id": "cta_color",
          "label": "Cta Mobile Color",
          "options": [
            {
              "value": "orange",
              "label": "Orange"
            },
            {
              "value": "blue",
              "label": "Blue"
            },
            {
              "value": "black",
              "label": "Black"
            },
            {
              "value": "white",
              "label": "White"
            }
          ],
          "default": "blue"
        }
      ]
    }
  ]
}
{% endschema %}

{% assign section_height = 'h-[var(--section-height)]' %}

{% if section.settings.section_height == 'height_60' %}
  {% assign section_height = 'h-[60vh]' %}
{% endif %}
{% if section.settings.section_height == 'height_80' %}
  {% assign section_height = 'h-[80vh]' %}
{% endif %}

{% render 'homepage-split-hero',
  blocks: section.blocks,
  title: section.settings.title,
  video: section.settings.video,
  image: section.settings.image,
  section_height: section_height
%}

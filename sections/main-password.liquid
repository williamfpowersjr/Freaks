<div
  id="passwordForm"
  class="fn-tt-body-30 fixed left-1/2 top-1/2 z-50 hidden -translate-x-1/2 -translate-y-1/2 bg-white p-144"
>
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}

    <div class="password">
      <label for="password">Password</label>
      <input type="password" name="password" class="border border-black">
    </div>

    <div class="submit cursor-pointer bg-grey-DARK text-center">
      <input type="submit" value="Sign in">
    </div>
  {% endform %}
</div>
<script>
  const currentUrl = new URL(window.location.href);

  if (currentUrl.searchParams.get('show_password_form') === 'true') {
    // Add your functionality here. For example:
    console.log('The show_password_form parameter is set to true.');

    // Example action: Show a password form
    // console.log(document.querySelector('#passwordForm'));
    // console.log(document.getElementById('passwordForm'));
    document.getElementById('passwordForm').style.display = 'block';
  } else {
    // Optional: Actions to perform if the parameter is not 'true' or not present
    console.log('The show_password_form parameter is not set to true.');
  }
</script>

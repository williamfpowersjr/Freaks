{{ 'ctr-comparison-table.css' | asset_url | stylesheet_tag }}

{% assign ctr_comparison_column_count = section.settings.column_count | default: '4' | plus: 0 %}
{% assign ctr_comparison_button_link = section.settings.button_link %}
{% assign ctr_comparison_cta_product = section.settings.cta_product %}
{% assign ctr_comparison_cta_variant_id = blank %}
{% assign ctr_comparison_cta_selling_plan_id = blank %}
{% assign ctr_comparison_button_icon_classes = '' %}
{% case section.settings.button_arrow_direction %}
  {% when 'top' %}
    {% assign ctr_comparison_button_icon_classes = '-rotate-90' %}
  {% when 'down' %}
    {% assign ctr_comparison_button_icon_classes = 'rotate-90' %}
{% endcase %}
{% if ctr_comparison_cta_product != blank %}
  {% assign ctr_comparison_cta_variant_id = ctr_comparison_cta_product.selected_or_first_available_variant.id %}
  {% assign ctr_comparison_cta_variant = ctr_comparison_cta_product.selected_or_first_available_variant %}
  {% if ctr_comparison_cta_variant.selling_plan_allocations.size > 0 %}
    {% assign ctr_comparison_cta_first_allocation = ctr_comparison_cta_variant.selling_plan_allocations.first %}
    {% assign ctr_comparison_cta_selling_plan_id = ctr_comparison_cta_first_allocation.selling_plan.id %}
  {% endif %}
{% endif %}
{% if section.settings.cta_adds_to_cart and ctr_comparison_cta_variant_id != blank %}
  {% assign ctr_comparison_button_link = '/cart/add?id='
    | append: ctr_comparison_cta_variant_id
    | append: '&quantity=1'
  %}
  {% if ctr_comparison_cta_selling_plan_id != blank %}
    {% assign ctr_comparison_button_link = ctr_comparison_button_link
      | append: '&selling_plan='
      | append: ctr_comparison_cta_selling_plan_id
    %}
  {% endif %}
{% endif %}
{% if ctr_comparison_button_link == blank %}
  {% assign ctr_comparison_button_link = '#' %}
{% endif %}

<section
  id="comparison-table"
  class="ctr-comparison-table ctr-comparison-table--cols-{{ ctr_comparison_column_count }} ctr-comparison-table--cell-align-mobile-{{ section.settings.cell_text_align_mobile }} ctr-comparison-table--cell-align-desktop-{{ section.settings.cell_text_align }}{% unless section.settings.use_custom_labels_column_width %} ctr-comparison-table--labels-equal{% endunless %}"
  data-section-id="{{ section.id }}"
  style="
    --ctr-comparison-table-label-column-width: {{ section.settings.labels_column_width }}%;
    --ctr-comparison-table-label-column-width-mobile: {{ section.settings.labels_column_width_mobile }}%;
    --ctr-comparison-table-column-count: {{ ctr_comparison_column_count }};
    {% if section.settings.background_gradient != blank %}
      --ctr-comparison-table-background: {{ section.settings.background_gradient }};
    {% else %}
      --ctr-comparison-table-background: {{ section.settings.background_color }};
    {% endif %}
    --ctr-comparison-table-card-background: {{ section.settings.card_background }};
    --ctr-comparison-table-highlight-column-background: {{ section.settings.highlight_column_background }};
    --ctr-comparison-table-border-color: {{ section.settings.border_color }};
    --ctr-comparison-table-heading-color: {{ section.settings.heading_color }};
    --ctr-comparison-table-subheading-color: {{ section.settings.subheading_color }};
    --ctr-comparison-table-row-label-color: {{ section.settings.row_label_color }};
    --ctr-comparison-table-column-label-color: {{ section.settings.column_label_color }};
    --ctr-comparison-table-header-image-max-width-mobile: {{ section.settings.header_image_max_width_mobile }}px;
    --ctr-comparison-table-header-image-max-width-desktop: {{ section.settings.header_image_max_width_desktop }}px;
    --ctr-comparison-table-highlight-header-image-max-width-mobile: {{ section.settings.highlight_header_image_max_width_mobile }}px;
    --ctr-comparison-table-highlight-header-image-max-width-desktop: {{ section.settings.highlight_header_image_max_width_desktop }}px;
    --ctr-comparison-table-header-image-margin-top-mobile: {{ section.settings.header_image_margin_top_mobile }}px;
    --ctr-comparison-table-header-image-margin-top-desktop: {{ section.settings.header_image_margin_top_desktop }}px;
    --ctr-comparison-table-highlight-header-image-margin-top-mobile: {{ section.settings.highlight_header_image_margin_top_mobile }}px;
    --ctr-comparison-table-highlight-header-image-margin-top-desktop: {{ section.settings.highlight_header_image_margin_top_desktop }}px;
    --ctr-comparison-table-padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --ctr-comparison-table-padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --ctr-comparison-table-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --ctr-comparison-table-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --ctr-comparison-table-wrapper-gap-desktop: {{ section.settings.wrapper_gap_desktop }}px;
    --ctr-comparison-table-wrapper-gap-mobile: {{ section.settings.wrapper_gap_mobile }}px;
    --ctr-comparison-table-icon-size-desktop: {{ section.settings.icon_width_desktop }}px;
    --ctr-comparison-table-icon-size-mobile: {{ section.settings.icon_width_mobile }}px;
    --ctr-comparison-table-row-label-font-size-desktop: {{ section.settings.row_label_font_size_desktop }}px;
    --ctr-comparison-table-row-label-font-size-mobile: {{ section.settings.row_label_font_size_mobile }}px;
    --ctr-comparison-table-cell-title-font-size-desktop: {{ section.settings.cell_title_font_size_desktop }}px;
    --ctr-comparison-table-cell-title-font-size-mobile: {{ section.settings.cell_title_font_size_mobile }}px;
    --ctr-comparison-table-highlight-cell-title-font-size-desktop: {{ section.settings.highlight_cell_title_font_size_desktop }}px;
    --ctr-comparison-table-highlight-cell-title-font-size-mobile: {{ section.settings.highlight_cell_title_font_size_mobile }}px;
    --ctr-comparison-table-cell-subtitle-font-size-desktop: {{ section.settings.cell_subtitle_font_size_desktop }}px;
    --ctr-comparison-table-cell-subtitle-font-size-mobile: {{ section.settings.cell_subtitle_font_size_mobile }}px;
    --ctr-comparison-table-header-cell-padding-y-desktop: {{ section.settings.header_cell_padding_y_desktop }}px;
    --ctr-comparison-table-header-cell-padding-x-desktop: {{ section.settings.header_cell_padding_x_desktop }}px;
    --ctr-comparison-table-header-cell-padding-y-mobile: {{ section.settings.header_cell_padding_y_mobile }}px;
    --ctr-comparison-table-header-cell-padding-x-mobile: {{ section.settings.header_cell_padding_x_mobile }}px;
    --ctr-comparison-table-row-label-cell-padding-y-desktop: {{ section.settings.row_label_cell_padding_y_desktop }}px;
    --ctr-comparison-table-row-label-cell-padding-x-desktop: {{ section.settings.row_label_cell_padding_x_desktop }}px;
    --ctr-comparison-table-row-label-cell-padding-y-mobile: {{ section.settings.row_label_cell_padding_y_mobile }}px;
    --ctr-comparison-table-row-label-cell-padding-x-mobile: {{ section.settings.row_label_cell_padding_x_mobile }}px;
    --ctr-comparison-table-cell-padding-y-desktop: {{ section.settings.cell_padding_y_desktop }}px;
    --ctr-comparison-table-cell-padding-x-desktop: {{ section.settings.cell_padding_x_desktop }}px;
    --ctr-comparison-table-cell-padding-y-mobile: {{ section.settings.cell_padding_y_mobile }}px;
    --ctr-comparison-table-cell-padding-x-mobile: {{ section.settings.cell_padding_x_mobile }}px;
  "
>
  <div class="ctr-comparison-table__wrapper">
    <div class="ctr-comparison-table__header{% if section.settings.subtitle == blank %} ctr-comparison-table__header--no-subtitle{% endif %} font-neue">
      {% if section.settings.title != blank %}
        <div class="ctr-comparison-table__title inline-rich-text">
          {{ section.settings.title }}
        </div>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <div class="ctr-comparison-table__subtitle ctr-comparison-table__subtitle--desktop inline-rich-text">
          {{ section.settings.subtitle }}
        </div>
      {% endif %}
    </div>

    {% if section.settings.subtitle != blank %}
      <div class="ctr-comparison-table__subtitle ctr-comparison-table__subtitle--mobile inline-rich-text">
        {{ section.settings.subtitle }}
      </div>
    {% endif %}

    <div class="ctr-comparison-table__table-wrap">
      <div class="ctr-comparison-table__table">
        {% assign ctr_comparison_header_block = blank %}
        {% for block in section.blocks %}
          {% if block.type == 'header_row' %}
            {% assign ctr_comparison_header_block = block %}
            {% break %}
          {% endif %}
        {% endfor %}

        <div
          class="ctr-comparison-table__row ctr-comparison-table__row--header"
          role="row"
          {% if ctr_comparison_header_block != blank %}
            {{- ctr_comparison_header_block.shopify_attributes -}}
          {% endif %}
        >
          <div class="ctr-comparison-table__cell ctr-comparison-table__cell--row-label" role="columnheader"></div>
          {% for ctr_comparison_column_index in (1..ctr_comparison_column_count) %}
            {% capture ctr_comparison_header_label_key %}col_{{ ctr_comparison_column_index }}_label{% endcapture %}
            {% capture ctr_comparison_header_mobile_label_key %}col_{{ ctr_comparison_column_index }}_label_mobile{% endcapture %}
            {% capture ctr_comparison_header_image_key %}col_{{ ctr_comparison_column_index }}_image{% endcapture %}
            {% assign ctr_comparison_header_label = '' %}
            {% assign ctr_comparison_header_mobile_label = '' %}
            {% assign ctr_comparison_header_image = blank %}
            {% assign ctr_comparison_header_logo_image = blank %}
            {% if ctr_comparison_header_block != blank %}
              {% assign ctr_comparison_header_label = ctr_comparison_header_block.settings[ctr_comparison_header_label_key] %}
              {% assign ctr_comparison_header_mobile_label = ctr_comparison_header_block.settings[ctr_comparison_header_mobile_label_key] %}
              {% assign ctr_comparison_header_image = ctr_comparison_header_block.settings[ctr_comparison_header_image_key] %}
              {% if ctr_comparison_column_index == 1 %}
                {% assign ctr_comparison_header_logo_image = ctr_comparison_header_block.settings.col_1_logo_image %}
              {% endif %}
            {% endif %}
            <div
              class="ctr-comparison-table__cell{% if ctr_comparison_column_index == 1 %} ctr-comparison-table__cell--highlight{% endif %}"
              role="columnheader"
            >
              {% if ctr_comparison_header_label != blank
                or ctr_comparison_header_image != blank
                or ctr_comparison_header_logo_image != blank
              %}
                <div class="ctr-comparison-table__header-content">
                  {% if ctr_comparison_header_image != blank %}
                    {% assign ctr_comparison_header_image_alt = ctr_comparison_header_image.alt
                      | default: ctr_comparison_header_label
                      | strip_html
                      | strip
                    %}
                    <img
                      src="{{ ctr_comparison_header_image | image_url: width: 600 }}"
                      alt="{{ ctr_comparison_header_image_alt | escape }}"
                      class="ctr-comparison-table__header-image"
                      loading="lazy"
                      width="{{ ctr_comparison_header_image.width }}"
                      height="{{ ctr_comparison_header_image.height }}"
                    >
                  {% endif %}
                  {% if ctr_comparison_header_logo_image != blank %}
                    {% assign ctr_comparison_header_logo_alt = ctr_comparison_header_logo_image.alt
                      | default: ctr_comparison_header_label
                      | strip_html
                      | strip
                    %}
                    <img
                      src="{{ ctr_comparison_header_logo_image | image_url: width: 400 }}"
                      alt="{{ ctr_comparison_header_logo_alt | escape }}"
                      class="ctr-comparison-table__header-logo-image"
                      loading="lazy"
                      width="{{ ctr_comparison_header_logo_image.width }}"
                      height="{{ ctr_comparison_header_logo_image.height }}"
                    >
                  {% endif %}
                  {% if ctr_comparison_header_label != blank %}
                    <div class="ctr-comparison-table__column-label ctr-comparison-table__column-label--desktop inline-rich-text">
                      {{ ctr_comparison_header_label }}
                    </div>
                  {% endif %}
                  {% if ctr_comparison_header_mobile_label != blank %}
                    <div class="ctr-comparison-table__column-label ctr-comparison-table__column-label--mobile inline-rich-text">
                      {{ ctr_comparison_header_mobile_label }}
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        {% for block in section.blocks %}
          {% if block.type == 'comparison_row' %}
            <div class="ctr-comparison-table__row" role="row" {{ block.shopify_attributes }}>
              <div class="ctr-comparison-table__cell ctr-comparison-table__cell--row-label" role="rowheader">
                {% if block.settings.label != blank %}
                  <div class="ctr-comparison-table__row-label inline-rich-text fn-tt-sub-title-30">
                    {{ block.settings.label }}
                  </div>
                {% endif %}
              </div>

              {% for ctr_comparison_column_index in (1..ctr_comparison_column_count) %}
                {% capture ctr_comparison_cell_label_key %}col_{{ ctr_comparison_column_index }}_label{% endcapture %}
                {% capture ctr_comparison_cell_subtitle_key %}col_{{ ctr_comparison_column_index }}_subtitle{% endcapture %}
                {% capture ctr_comparison_cell_icon_key %}col_{{ ctr_comparison_column_index }}_icon{% endcapture %}
                {% assign ctr_comparison_cell_label = block.settings[ctr_comparison_cell_label_key] %}
                {% assign ctr_comparison_cell_subtitle = block.settings[ctr_comparison_cell_subtitle_key] %}
                {% assign ctr_comparison_icon_type = block.settings[ctr_comparison_cell_icon_key] %}
                {% assign ctr_comparison_has_icon = false %}
                {% if ctr_comparison_icon_type == 'check' or ctr_comparison_icon_type == 'minus' %}
                  {% assign ctr_comparison_has_icon = true %}
                {% endif %}
                <div
                  class="ctr-comparison-table__cell{% if ctr_comparison_column_index == 1 %} ctr-comparison-table__cell--highlight{% endif %}"
                  role="cell"
                >
                  {% if ctr_comparison_cell_label != blank
                    or ctr_comparison_cell_subtitle != blank
                    or ctr_comparison_has_icon
                  %}
                    <div class="ctr-comparison-table__cell-content">
                      <div class="ctr-comparison-table__cell-main{% if ctr_comparison_has_icon %} ctr-comparison-table__cell-main--with-icon{% endif %}">
                        {% if ctr_comparison_icon_type == 'check' and section.settings.check_icon != blank %}
                          <img
                            src="{{ section.settings.check_icon | image_url: width: 80 }}"
                            alt="Check"
                            class="ctr-comparison-table__icon"
                            loading="lazy"
                            width="{{ section.settings.check_icon.width }}"
                            height="{{ section.settings.check_icon.height }}"
                          >
                        {% elsif ctr_comparison_icon_type == 'minus' and section.settings.minus_icon != blank %}
                          <img
                            src="{{ section.settings.minus_icon | image_url: width: 80 }}"
                            alt="Minus"
                            class="ctr-comparison-table__icon"
                            loading="lazy"
                            width="{{ section.settings.minus_icon.width }}"
                            height="{{ section.settings.minus_icon.height }}"
                          >
                        {% elsif ctr_comparison_icon_type == 'check' %}
                          <span class="ctr-comparison-table__icon-fallback" aria-label="Check">+</span>
                        {% elsif ctr_comparison_icon_type == 'minus' %}
                          <span class="ctr-comparison-table__icon-fallback" aria-label="Minus">-</span>
                        {% endif %}

                        {% if ctr_comparison_cell_label != blank %}
                          <div class="ctr-comparison-table__cell-text inline-rich-text fn-tt-sub-title-20">
                            {{ ctr_comparison_cell_label }}
                          </div>
                        {% endif %}
                      </div>

                      {% if ctr_comparison_cell_subtitle != blank %}
                        <div class="ctr-comparison-table__cell-subtitle inline-rich-text{% if ctr_comparison_has_icon %} ctr-comparison-table__cell-subtitle--with-icon{% endif %}">
                          {{ ctr_comparison_cell_subtitle }}
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% if section.settings.button_label != blank %}
      <div class="ctr-comparison-table__button-wrap">
        {% render 'cta',
          as: 'a',
          href: ctr_comparison_button_link,
          text: section.settings.button_label,
          hasIcons: true,
          cta_color: 'orange',
          extra_classes: 'ctr-comparison-table__button',
          extra_icon_classes: ctr_comparison_button_icon_classes
        %}
      </div>
    {% endif %}
    {% if section.settings.footnote != blank or section.settings.legal_badge != blank %}
      <div class="ctr-comparison-table__footer">
        {% if section.settings.footnote != blank %}
          <div class="ctr-comparison-table__footnote inline-rich-text">
            {{ section.settings.footnote }}
          </div>
        {% endif %}
        {% if section.settings.legal_badge != blank %}
          <div class="ctr-comparison-table__badge">
            {{ section.settings.legal_badge }}
          </div>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Comparison Table (CTR)",
  "tag": "section",
  "class": "ctr-comparison-table-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>This isn't your regular <em>electrolyte.</em></p>"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "<p>Five systems vs. just one. The math is on the table.</p>"
    },
    {
      "type": "header",
      "content": "Table structure"
    },
    {
      "type": "select",
      "id": "column_count",
      "label": "Column count",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "use_custom_labels_column_width",
      "label": "Use custom labels column width",
      "default": true
    },
    {
      "type": "range",
      "id": "labels_column_width",
      "label": "Labels column width",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 24,
      "visible_if": "{{ section.settings.use_custom_labels_column_width == true }}"
    },
    {
      "type": "range",
      "id": "labels_column_width_mobile",
      "label": "Labels column width mobile",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 30,
      "visible_if": "{{ section.settings.use_custom_labels_column_width == true }}"
    },
    {
      "type": "header",
      "content": "Icons and footer"
    },
    {
      "type": "image_picker",
      "id": "check_icon",
      "label": "Check icon"
    },
    {
      "type": "image_picker",
      "id": "minus_icon",
      "label": "Minus icon"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote",
      "default": "<p>Based on clinical studies. Sources available on request.</p>"
    },
    {
      "type": "text",
      "id": "legal_badge",
      "label": "Legal badge",
      "default": "HOLD - LEGAL"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "select",
      "id": "button_arrow_direction",
      "label": "Button arrow direction",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "down",
          "label": "Down"
        }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "cta_adds_to_cart",
      "label": "CTA adds to cart",
      "default": false
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "visible_if": "{{ section.settings.cta_adds_to_cart == false }}"
    },
    {
      "type": "product",
      "id": "cta_product",
      "label": "CTA product",
      "info": "Used only if CTA adds to cart is enabled"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "background_gradient",
      "label": "Section background gradient",
      "info": "Example: linear-gradient(180deg, #FFFFFF 0%, #FFF2E9 100%)"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "highlight_column_background",
      "label": "Highlight column background",
      "alpha": true,
      "default": "#E5581F1A"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "alpha": true,
      "default": "#21212126"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#212121"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "alpha": true,
      "default": "#21212199"
    },
    {
      "type": "color",
      "id": "row_label_color",
      "label": "Row label color",
      "default": "#212121"
    },
    {
      "type": "color",
      "id": "column_label_color",
      "label": "Column label color",
      "default": "#2c2c2c"
    },
    {
      "type": "select",
      "id": "cell_text_align",
      "label": "Cell text align desktop",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "cell_text_align_mobile",
      "label": "Cell text align mobile",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Cell padding"
    },
    {
      "type": "range",
      "id": "header_cell_padding_y_desktop",
      "label": "Header cell padding Y desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "header_cell_padding_x_desktop",
      "label": "Header cell padding X desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "header_cell_padding_y_mobile",
      "label": "Header cell padding Y mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "header_cell_padding_x_mobile",
      "label": "Header cell padding X mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "row_label_cell_padding_y_desktop",
      "label": "Row label cell padding Y desktop",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "row_label_cell_padding_x_desktop",
      "label": "Row label cell padding X desktop",
      "min": 0,
      "max": 200,

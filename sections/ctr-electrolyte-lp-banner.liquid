{{ 'ctr-electrolyte-lp-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ctr_electrolyte_lp_banner_button_icon_classes = ''
  case section.settings.cta_arrow_direction
    when 'top'
      assign ctr_electrolyte_lp_banner_button_icon_classes = '-rotate-90'
    when 'down'
      assign ctr_electrolyte_lp_banner_button_icon_classes = 'rotate-90'
  endcase
-%}

<div
  class="ctr-electrolyte-lp-banner{% if section.settings.text_theme == 'light' %} ctr-electrolyte-lp-banner--light{% endif %}"
  style="
    background-color: {{ section.settings.bg_color }};
    --ctr-elpb-pt-desktop: {{ section.settings.pt_desktop }}px;
    --ctr-elpb-pb-desktop: {{ section.settings.pb_desktop }}px;
    --ctr-elpb-pt-mobile: {{ section.settings.pt_mobile }}px;
    --ctr-elpb-pb-mobile: {{ section.settings.pb_mobile }}px;
    --ctr-elpb-min-height-desktop: {{ section.settings.min_height_desktop }}px;
    --ctr-elpb-min-height-mobile: {{ section.settings.min_height_mobile }}px;
    --ctr-elpb-content-position-mobile: {{ section.settings.content_position_mobile }};
    --ctr-elpb-img-position-desktop: {{ section.settings.image_position_desktop }};
    --ctr-elpb-img-position-mobile: {{ section.settings.image_position_mobile }};
  "
>
  {%- comment -%} Background images + gradient overlay {%- endcomment -%}
  {% if section.settings.image != blank %}
    <div class="ctr-electrolyte-lp-banner__bg ctr-electrolyte-lp-banner__bg--desktop" aria-hidden="true">
      <img
        class="ctr-electrolyte-lp-banner__bg-img"
        src="{{ section.settings.image | img_url: '1600x' }}"
        alt=""
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
      >
      <div
        class="ctr-electrolyte-lp-banner__gradient"
        style="background: linear-gradient(to right, {{ section.settings.bg_color }} 36%, transparent 58%);"
      ></div>
    </div>
  {% endif %}

  {%- assign mobile_bg_image = section.settings.mobile_image | default: section.settings.image -%}
  {% if mobile_bg_image != blank %}
    <div class="ctr-electrolyte-lp-banner__bg ctr-electrolyte-lp-banner__bg--mobile" aria-hidden="true">
      <img
        class="ctr-electrolyte-lp-banner__bg-img"
        src="{{ mobile_bg_image | img_url: '800x' }}"
        alt=""
        width="{{ mobile_bg_image.width }}"
        height="{{ mobile_bg_image.height }}"
        loading="eager"
      >
    </div>
  {% endif %}

  {%- comment -%} Inner layout: left text column + right spacer {%- endcomment -%}
  <div class="ctr-electrolyte-lp-banner__inner">
    <div class="ctr-electrolyte-lp-banner__content">
      {% if section.settings.eyebrow != blank %}
        <p class="ctr-electrolyte-lp-banner__eyebrow fn-tt-body-20">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <div class="ctr-electrolyte-lp-banner__headline">
        {% if section.settings.title != blank %}
          <div class="ctr-electrolyte-lp-banner__title">{{ section.settings.title }}</div>
        {% endif %}
        {% if section.settings.title_accent != blank %}
          <div class="ctr-electrolyte-lp-banner__title-accent">{{ section.settings.title_accent }}</div>
        {% endif %}
      </div>

      {% if section.settings.description != blank %}
        <div class="ctr-electrolyte-lp-banner__description ctr-electrolyte-lp-banner__description--desktop">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% assign description_mobile = section.settings.description_mobile | default: section.settings.description %}
      {% if description_mobile != blank and section.settings.description_mobile != blank %}
        <div class="ctr-electrolyte-lp-banner__description ctr-electrolyte-lp-banner__description--mobile">
          {{ description_mobile }}
        </div>
      {% endif %}

      {% if section.settings.cta_text != blank %}
        <a
          href="{{ section.settings.cta_link }}"
          class="ctr-electrolyte-lp-banner__cta"
          aria-label="{{ section.settings.cta_text }}"
          {% if section.settings.cta_open_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
        >
          {% render 'cta',
            as: 'button',
            text: section.settings.cta_text,
            hasIcons: true,
            cta_color: 'orange',
            extra_classes: 'w-full',
            extra_icon_classes: ctr_electrolyte_lp_banner_button_icon_classes
          %}
        </a>
      {% endif %}
    </div>
    <div class="ctr-electrolyte-lp-banner__spacer" aria-hidden="true"></div>
  </div>
</div>

{% schema %}
{
  "name": "Electrolyte Banner (CTR)",
  "tag": "section",
  "class": "ctr-electrolyte-lp-banner-section",
  "presets": [
    {
      "name": "Electrolyte Banner (CTR)",
      "category": "CTR Sections",
      "settings": {
        "eyebrow": "NEW · SKIN SUPPORT ELECTROLYTE",
        "title": "<p>Sunscreen</p><p>you can drink.</p>",
        "title_accent": "<p>Almost.</p>",
        "description": "<p>A daily electrolyte engineered with a clinically-backed UV Resilience Complex — so your skin gets reinforced from the inside before the sun ever touches it. Five systems supported. One sip.</p>",
        "cta_text": "Start my routine",
        "bg_color": "#581002",
        "pt_desktop": 100,
        "pb_desktop": 100,
        "pt_mobile": 24,
        "pb_mobile": 0
      }
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image",
      "info": "Used as background on desktop, shown below text on mobile."
    },
    {
      "type": "select",
      "id": "image_position_desktop",
      "label": "Desktop Image Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left", "label": "Left" },
        { "value": "center right", "label": "Right" },
        { "value": "top left", "label": "Top Left" },
        { "value": "top right", "label": "Top Right" },
        { "value": "bottom left", "label": "Bottom Left" },
        { "value": "bottom right", "label": "Bottom Right" }
      ],
      "default": "center center"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "info": "Optional. If blank, the desktop image is used on mobile."
    },
    {
      "type": "select",
      "id": "image_position_mobile",
      "label": "Mobile Image Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left", "label": "Left" },
        { "value": "center right", "label": "Right" },
        { "value": "top left", "label": "Top Left" },
        { "value": "top right", "label": "Top Right" },
        { "value": "bottom left", "label": "Bottom Left" },
        { "value": "bottom right", "label": "Bottom Right" }
      ],
      "default": "center center"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Label"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "info": "Main headline lines, displayed in white."
    },
    {
      "type": "richtext",
      "id": "title_accent",
      "label": "Title Accent",
      "info": "Last line displayed in orange. Leave blank to hide."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "richtext",
      "id": "description_mobile",
      "label": "Description (mobile)",
      "info": "Optional. Shown below 1024px when set; otherwise desktop description is used on all breakpoints."
    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "cta_open_new_tab",
      "label": "Open button link in new tab",
      "default": false
    },
    {
      "type": "select",
      "id": "cta_arrow_direction",
      "label": "Button arrow direction",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "top", "label": "Top" },
        { "value": "down", "label": "Down" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "text_theme",
      "label": "Text theme",
      "options": [
        { "value": "dark", "label": "Light text (dark backgrounds)" },
        { "value": "light", "label": "Dark text (light backgrounds)" }
      ],
      "default": "dark",
      "info": "Use dark text on light hero backgrounds (e.g. Ambassador Program)."
    },
    {
      "type": "text",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#581002",
      "info": "Hex color (e.g. #581002). Also used for the left-to-right gradient fade on desktop."
    },
    {
      "type": "header",
      "content": "Padding — Desktop"
    },
    {
      "type": "range",
      "id": "pt_desktop",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "pb_desktop",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Min Height",
      "min": 0,
      "max": 800,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding — Mobile"
    },
    {
      "type": "range",
      "id": "pt_mobile",
      "label": "Padding Top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "pb_mobile",
      "label": "Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Min Height",
      "min": 0,
      "max": 800,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "content_position_mobile",
      "label": "Content Position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "flex-start"
    }
  ]
}
{% endschema %}

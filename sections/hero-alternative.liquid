{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-alternative-section",
  "presets": [
    {
      "name": "Hero",
      "category": "Hero",
      "settings": {
        "image": "shopify://shop_images/02_SLATER_1149_rt2_1a574b68-3a9d-4a6f-86d9-dfc3cca4cce8.jpg",
        "bg_color": "white",
        "title": "Lorem ipsum",
        "cta": "Lorem ipsum",
        "cta_link": "#",
        "cta_color": "blue",
        "show_tagline": true,
        "tagline": "Lorem ipsum",
        "credit_title": "Lorem ipsum",
        "credit_logo": "shopify://shop_images/fon-logo.svg",
        "credit_url": "#"
      }
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "info": "Image to be shown on mobile devices.  If left blank, the desktop image will be shown on all devices.",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "This video is going to loop in the index page hero.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile Video",
      "info": "Video to be shown on mobile devices.  If left blank, the desktop video will be shown on all devices.",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Title Background Color",
      "options": [
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "offWhite",
          "label": "Off White"
        },
        {
          "value": "orange",
          "label": "Orange"
        }
      ],
      "default": "white"
    },
    {
      "type": "checkbox",
      "id": "show_tagline",
      "label": "Show tagline",
      "default": true,
      "info": "Use the checkbox to hide or show the Tagline in this section."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "info": "This will show as a small tagline on the bottom of the hero section"
    },
    {
      "type": "text",
      "id": "credit_title",
      "label": "Credit Title",
      "info": "This will show as a credit title in the tagline"
    },
    {
      "type": "image_picker",
      "id": "credit_logo",
      "label": "Credit Logo",
      "info": "This will show as the credit logo in the tagline"
    },
    {
      "type": "url",
      "id": "credit_url",
      "label": "Credit Url",
      "info": "This will link the credit inside the tagline"
    },

    {
      "type": "header",
      "content": "CTAs"
    },
    {
      "type": "select",
      "id": "cta_count",
      "label": "CTA Count",
      "options": [
        {
          "value": "1",
          "label": "Single CTA"
        },
        {
          "value": "2",
          "label": "Two CTAs"
        }
      ]
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA Style",
      "options": [
        {
          "value": "full_bleed",
          "label": "Full Bleed"
        },
        {
          "value": "margin",
          "label": "Margin"
        }
      ],
      "default": "full_bleed"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Cta Text",
      "info": "Optional: If you want to show a cta, fill in a Cta text. If you don't want to show it, leave the field blank."
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Cta link"
    },
    {
      "type": "select",
      "id": "cta_color",
      "label": "Cta Color",
      "options": [
        {
          "value": "orange",
          "label": "Orange"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "orange"
    },
    {
      "type": "text",
      "id": "cta_2",
      "label": "Cta Text 2",
      "visible_if": "{{ section.settings.cta_count == '2' }}"
    },
    {
      "type": "url",
      "id": "cta_2_link",
      "label": "Cta link 2",
      "visible_if": "{{ section.settings.cta_count == '2' }}"
    },
    {
      "type": "select",
      "id": "cta_2_color",
      "label": "Cta Color 2",
      "options": [
        {
          "value": "orange",
          "label": "Orange"
        },
        {
          "value": "blue",
          "label": "Blue"
        },
        {
          "value": "black",
          "label": "Black"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "blue",
      "visible_if": "{{ section.settings.cta_count == '2' }}"
    }
  ]
}
{% endschema %}

{% render 'hero-alternative',
  bg_color: section.settings.bg_color,
  media_type: section.settings.media_type,
  image: section.settings.image,
  mobile_image: section.settings.mobile_image,
  video: section.settings.video,
  mobile_video: section.settings.mobile_video,
  title: section.settings.title,
  cta: section.settings.cta,
  cta_link: section.settings.cta_link,
  cta_color: section.settings.cta_color,
  cta_2: section.settings.cta_2,
  cta_2_link: section.settings.cta_2_link,
  cta_2_color: section.settings.cta_2_color,
  cta_count: section.settings.cta_count,
  cta_style: section.settings.cta_style,
  show_tagline: section.settings.show_tagline,
  tagline: section.settings.tagline,
  credit_title: section.settings.credit_title,
  credit_logo: section.settings.credit_logo,
  credit_url: section.settings.credit_url
%}

{% schema %}
{
  "name": "Title with Navigation",
  "tag": "section",
  "class": "title-with-navigation-section",
  "presets": [
    {
      "name": "Title with Navigation",
      "category": "Title with Navigation",
      "settings": {
        "bg_color": "bg-white",
        "lg_bg_color": "lg:bg-white",
        "section_title": "Lorem ipsum",
        "title": "<p>Lorem ipsum</p>"
      }
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "lg_bg_color",
      "label": "Desktop Section Background Color",
      "options": [
        {
          "value": "lg:bg-white",
          "label": "White"
        },
        {
          "value": "lg:bg-offWhite",
          "label": "Off White"
        }
      ],
      "default": "lg:bg-white"
    },
    {
      "type": "select",
      "id": "bg_color",
      "label": "Mobile Section Background Color",
      "options": [
        {
          "value": "bg-white",
          "label": "White"
        },
        {
          "value": "bg-offWhite",
          "label": "Off White"
        }
      ],
      "default": "bg-white"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "info": "Required: Will show in the sticky navigation."
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title"
    }
  ]
}
{% endschema %}

{% assign combined_bg_classes = section.settings.bg_color | append: ' ' | append: section.settings.lg_bg_color %}

<div
  id="{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-title="{{ section.settings.section_title }}"
  class="relative w-full scroll-m-[calc(var(--header-height)+40px)] pb-32 lg:flex lg:scroll-m-[var(--header-height)] lg:justify-end lg:px-40 lg:pb-112 {{ section.settings.bg_color }} {{ section.settings.lg_bg_color }}"
>
  <div class="lg:w-3/4">
    {% render 'title',
      title: section.settings.title,
      text_size: 'fn-tt-title-60',
      extra_wrapper_classes: 'overflow-hidden px-24 lg:px-12 text-balance overflow-hidden ',
      text_color: 'text-black',
      bg_color: combined_bg_classes,
      bg_lines: 'bg-grey-lines',
      extra_text_classes: '!mt-0 !pt-0'
    %}
  </div>
</div>

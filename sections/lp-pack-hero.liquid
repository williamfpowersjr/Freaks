{%- comment -%}
  LP (variety pack): hero that sells the pack like a snack variety pack.
  Headline, a row of product cut-outs with a price-per-item sticker, price, button and a strip of numbers.
  {price} = the product's live price. {unit_price} = that price divided by the number of items in the pack.
{%- endcomment -%}
{{ 'lp-mini-deo.css' | asset_url | stylesheet_tag }}
{{ 'lp-pack.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign lp_variant = product.selected_or_first_available_variant
  assign lp_price = lp_variant.price | money_without_trailing_zeros
  assign lp_cutouts = section.blocks | where: 'type', 'product_image'
  assign lp_stats = section.blocks | where: 'type', 'stat'

  assign lp_unit_count = section.settings.unit_count | times: 1
  assign lp_unit_price = lp_price
  if lp_unit_count > 0
    assign lp_unit_price = lp_variant.price | divided_by: lp_unit_count | money_without_trailing_zeros
  endif

  assign lp_headline = section.settings.headline | replace: '{price}', lp_price | replace: '{unit_price}', lp_unit_price
  assign lp_subhead = section.settings.subhead | replace: '{price}', lp_price | replace: '{unit_price}', lp_unit_price

  comment
    Star rating comes live from the reviews product's Junip metafields.
  endcomment
  assign lp_reviews_product = section.settings.reviews_product | default: product
  assign lp_rating_field = lp_reviews_product.metafields.junip.rating_average
  assign lp_rating = lp_rating_field.value | default: lp_rating_field | times: 1.0 | round: 1
  assign lp_count_field = lp_reviews_product.metafields.junip.rating_count
  assign lp_rating_count = lp_count_field.value | default: lp_count_field | times: 1
-%}

<div class="lp-pack-hero">
  <div class="lp-wrap lp-pack-hero__grid">
    <div class="lp-pack-hero__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="lp-eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h1 class="lp-hero__headline">{{ lp_headline }}</h1>
      {% if lp_subhead != blank %}
        <p class="lp-hero__subhead">{{ lp_subhead }}</p>
      {% endif %}
    </div>

    <div class="lp-pack-hero__panel">
      {% if lp_cutouts.size > 0 %}
        {% render 'lp-lineup', images: lp_cutouts, eager: true, straight: true %}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'lp-hero__img lp-placeholder' }}
      {% endif %}

      {% if section.settings.sticker_text != blank and lp_unit_count > 0 %}
        <p class="lp-sticker">
          <span class="lp-sticker__big">{{ lp_unit_price }}</span>
          <span class="lp-sticker__small">{{ section.settings.sticker_text }}</span>
        </p>
      {% endif %}
    </div>

    <div class="lp-pack-hero__buy">
      <div class="lp-hero__cta-row">
        <a class="lp-btn" href="#lp-buy-box">
          {%- if product.available -%}
            {{ section.settings.cta }}
          {%- else -%}
            Sold out
          {%- endif -%}
        </a>
        <p class="lp-hero__price">
          {% if lp_variant.compare_at_price > lp_variant.price %}
            <s class="lp-price__compare">{{ lp_variant.compare_at_price | money_without_trailing_zeros }}</s>
          {% endif %}
          <span class="lp-price">{{ lp_price }}</span>
          {% if section.settings.price_note != blank %}
            <span class="lp-hero__price-note">{{ section.settings.price_note }}</span>
          {% endif %}
        </p>
      </div>

      {% if section.settings.show_rating and lp_rating_count > 0 %}
        <p class="lp-hero__rating">
          {% render 'lp-stars', rating: lp_rating %}
          <span>{{ lp_rating }} out of 5 · {{ lp_rating_count }} {{ section.settings.rating_label }}</span>
        </p>
      {% endif %}
    </div>
  </div>

  {% if lp_stats.size > 0 %}
    <div class="lp-stats">
      <ul class="lp-wrap lp-stats__list">
        {% for block in lp_stats %}
          <li class="lp-stats__item" {{ block.shopify_attributes }}>
            <span class="lp-stats__value">{{ block.settings.value }}</span>
            <span class="lp-stats__label">{{ block.settings.label }}</span>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "LP Pack hero",
  "tag": "section",
  "class": "lp-section lp-pack-hero-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "In the headline and subhead, {price} shows the live price and {unit_price} shows the price per item."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Variety pack. 4 minis."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "All four scents. One pack."
    },
    {
      "type": "text",
      "id": "subhead",
      "label": "Subhead",
      "default": "Four mini deos. One scent a week for a month."
    },
    {
      "type": "header",
      "content": "Price per item sticker"
    },
    {
      "type": "number",
      "id": "unit_count",
      "label": "Items in the pack",
      "info": "The sticker shows the live price divided by this number.",
      "default": 4
    },
    {
      "type": "text",
      "id": "sticker_text",
      "label": "Text under the price per item",
      "info": "Leave empty to hide the sticker.",
      "default": "a mini"
    },
    {
      "type": "header",
      "content": "Price and button"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Button text",
      "default": "Get the pack"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Note next to price",
      "default": "for 4 minis"
    },
    {
      "type": "header",
      "content": "Star rating"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "product",
      "id": "reviews_product",
      "label": "Reviews product",
      "info": "Rating and count come live from this product's Junip reviews."
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Text after the review count",
      "default": "reviews of Everyday Endurance Deodorant"
    }
  ],
  "blocks": [
    {
      "type": "product_image",
      "name": "Product cut-out",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "A tall cut-out on a transparent background works best. Up to four stand side by side."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "default": "Mini deodorant"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Number",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Number",
          "default": "4"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "minis"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP Pack hero"
    }
  ]
}
{% endschema %}

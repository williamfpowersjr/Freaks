            "caption": "Lorem ipsum",
            "video": "",
            "hide_mute": false,
            "full_bleed_media": false
          }
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "bg_color",
      "label": "Background Color",
      "options": [
        {
          "value": "bg-white",
          "label": "White"
        },
        {
          "value": "bg-offWhite",
          "label": "Off White"
        }
      ],
      "default": "bg-white"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    }
  ],
  "blocks": [
    {
      "name": "Item",
      "type": "item",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "select",
          "id": "description_size",
          "label": "Description Font Size",
          "options": [
            {
              "value": "small_text",
              "label": "Small"
            },

            {
              "value": "big_text",
              "label": "Big"
            }
          ],
          "default": "big_text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Optional: Image Caption"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "If you add a video, it will be shown. If you want to have a still image, leave the video field blank."
        },
        {
          "type": "checkbox",
          "id": "hide_mute",
          "label": "Hide Mute",
          "info": "Check on if you would like to hide the mute/unmute control button for the video.",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "full_bleed_media",
          "label": "Media is full bleed",
          "default": false,
          "info": "Check on if you would like the media to be full bleed."
        }
      ]
    }
  ]
}
{% endschema %}

{% render 'split-screen',
  title: section.settings.title,
  blocks: section.blocks,
  bg_color: section.settings.bg_color,
  has_border_top: true
%}

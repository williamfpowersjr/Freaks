{% schema %}
{
  "name": "Before After Product",
  "tag": "section",
  "class": "before-after-product-section",
  "max_blocks": 2,
  "presets": [
    {
      "name": "Before After Product",
      "settings": {
        "bg_color": "bg-white",
        "product": "peak-performance-sunscreen",
        "text": "Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua."
      },
      "blocks": [
        {
          "type": "image-card",
          "settings": {
            "image": "shopify://shop_images/02_SLATER_1149_rt2_1a574b68-3a9d-4a6f-86d9-dfc3cca4cce8.jpg",
            "tag": "Before",
            "padding": false
          }
        },
        {
          "type": "image-card",
          "settings": {
            "image": "shopify://shop_images/02_SLATER_1149_rt2_1a574b68-3a9d-4a6f-86d9-dfc3cca4cce8.jpg",
            "tag": "After",
            "padding": false
          }
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "bg_color",
      "label": "Background Color",
      "options": [
        {
          "value": "bg-white",
          "label": "White"
        },
        {
          "value": "bg-offWhite",
          "label": "Off White"
        }
      ],
      "default": "bg-white"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    }
  ],
  "blocks": [{ "type": "image-card" }],
  "enabled_on": {
    "templates": ["*"]
  }
}
{% endschema %}

{% assign product_image = section.settings.product.featured_image %}
{% assign product_title = section.settings.product.title %}
{% assign product_type = section.settings.product.type %}
{% assign product_link = section.settings.product.url %}

{% if section.blocks.size > 0 %}
  <div class="lg:my-40 lg:px-40 {{ section.settings.bg_color }}">
    <div class="grid grid-cols-2 lg:min-h-464 lg:grid-cols-4">
      <div class="col-span-2">
        <div class="flex flex-col gap-64 bg-blue/20 p-24 lg:h-full lg:justify-between lg:p-40">
          <div class="flex flex-col-reverse gap-y-64 lg:flex-col lg:gap-y-24">
            {% if section.settings.product != blank %}
              <div class="flex items-center gap-16">
                {% if product_image %}
                  <div class="relative">
                    <div class="size-72 bg-white">
                      {{
                        product_image
                        | image_url: width: product_image.width
                        | image_tag:
                          loading: 'lazy',
                          sizes: '25vw',
                          class: 'w-full h-full object-cover absolute inset-0 z-0'
                      }}
                    </div>
                  </div>
                {% endif %}
                <div class="flex flex-col">
                  <p class="fn-tt-body-20 text-blue">{{ product_title }}</p>
                  <p class="fn-tt-body-20 text-blue/40">{{ product_type }}</p>
                </div>
              </div>
            {% endif %}

            {% if section.settings.text != blank %}
              <p class="fn-tt-title-30 text-blue">{{ section.settings.text }}</p>
            {% endif %}
          </div>
          {% if product_link != blank %}
            <a href="{{ product_link }}" class="hidden lg:block" aria-label="{{ product_title }}">
              {% render 'cta',
                as: 'button',
                text: product_title,
                extra_classes: 'w-full',
                hasIcons: true,
                cta_color: 'blue'
              %}
            </a>
          {% endif %}
        </div>
      </div>
      <div class="col-span-2">
        <div class="grid grid-cols-2 lg:h-full [&>*]:aspect-[0.8] [&>*]:lg:aspect-auto [&>*]:lg:h-full">
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
    {% if product_link != blank %}
      <div class="bg-blue/20 p-24 lg:hidden">
        <a href="{{ product_link }}" aria-label="{{ product_title }}">
          {% render 'cta',
            as: 'button',
            text: product_title,
            extra_classes: 'w-full',
            hasIcons: true,
            cta_color: 'blue'
          %}
        </a>
      </div>
    {% endif %}
  </div>
{% endif %}

{% # theme-check-disable %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="h-full scroll-smooth">
  <head>
    {% render 'visually_io_sdk' %}

    {% if request.path contains '/gift_cards' %}
      {% render 'head-favicon' %}
      {% assign gift_card_price = '' %}

      {% if settings.currency_code_enabled %}
        {% assign gift_card_price = gift_card.balance | money_with_currency %}
      {% else %}
        {% assign gift_card_price = gift_card.balance | money %}
      {% endif %}

      {% assign page_title = "Here's your "
        | append: gift_card_price
        | append: ' gift card balance for '
        | append: shop.name
        | append: '!'
      %}
      {% assign page_description = settings.giftcard_title %}

      {% render 'head-meta', page_title: page_title, page_description: page_description %}

    {% else %}
      {% render 'head-meta' %}
    {% endif %}

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {% render 'head-favicon' %}

    <title>
      {{ page_title }}
      {% if current_tags %}
        tagged "{{ current_tags | join: ', ' }}"
      {% endif %}
      {% if current_page != 1 %}
        Page {{ current_page -}}
      {% endif %}
      {% unless page_title contains shop.name %}
        {{ shop.name -}}
      {% endunless %}
    </title>

    {{ content_for_header }}

    {% render 'head-styles' %}
    {% render 'head-scripts' %}
  </head>

  <body class="relative flex h-full min-w-[320px] flex-col overflow-x-hidden bg-white font-text leading-none text-black antialiased">
    {% if request.path contains '/password' %}
      {% section 'header-coming-soon' %}
    {% else %}
      {% section 'header' %}
      {% comment %} Disable cart drawer for Rebuy Cart {% endcomment %}
      {% comment %} {% section 'cart-drawer' %} {% endcomment %}
    {% endif %}

    <main
      class="flex-1"
    >
      {{ content_for_layout }}
    </main>

    {% unless request.path contains '/password' %}
      {% section 'footer' %}
    {% endunless %}
    {% render 'junip-store-key' %}

    <script src="https://cdn.jsdelivr.net/npm/vanilla-lazyload@19.1.3/dist/lazyload.min.js"></script>
  </body>
</html>

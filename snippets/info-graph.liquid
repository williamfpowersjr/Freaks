<div class="{{ bg_card_color }} relative flex flex-col divide-y divide-black/15 overflow-hidden lg:min-h-[560px] lg:w-3/4 lg:flex-row lg:divide-x lg:divide-y-0 ">
  {% if image != blank %}
    <div class="relative aspect-square w-full lg:h-full lg:w-1/2 ">
      {{
        image
        | image_url: width: image.width
        | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 1024px) 50vw, 100vw',
          class: 'w-full h-full object-cover absolute inset-0 z-0'
      }}
    </div>
  {% endif %}

  {% if description != blank %}
    <div class="flex flex-col lg:h-full lg:w-1/2">
      <div class="p-24 lg:flex-1 lg:p-40 lg:pb-24">
        <div class="fn-tt-title-20 lg:fn-tt-sub-title-30 ">
          {% assign text_with_sup = description
            | replace: '¹', '<sup>1</sup>'
            | replace: '²', '<sup>2</sup>'
            | replace: '³', '<sup>3</sup>'
            | replace: '⁴', '<sup>4</sup>'
            | replace: '⁵', '<sup>5</sup>'
            | replace: '⁶', '<sup>6</sup>'
            | replace: '⁷', '<sup>7</sup>'
            | replace: '⁸', '<sup>8</sup>'
            | replace: '⁹', '<sup>9</sup>'
          %}
          {{ text_with_sup }}
        </div>
      </div>

      {% if section.blocks.size > 0 %}
        <div class="border-t border-black/15 p-24 pt-24 lg:px-40 lg:pb-40">
          <div class="flex flex-col gap-16">
            {% for block in section.blocks %}
              {% if block.type == 'info' %}
                <div class="flex items-center gap-16">
                  <div class="{{ block.settings.indicator_color }} h-8 w-8 rounded-full"></div>
                  <p class="fn-tt-title-20 lg:fn-tt-sub-title-30">{{ block.settings.info }}</p>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>

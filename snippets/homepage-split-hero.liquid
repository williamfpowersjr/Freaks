<div class="relative z-10 flex flex-col {{ section_height }} lg:grid lg:grid-cols-2">
  <div data-section class="group relative z-0 h-full lg:hover:cursor-pointer">
    {% if video == blank %}
      {% if image != blank %}
        {{
          image
          | image_url: width: image.width
          | image_tag: loading: 'eager', preload: true, class: 'w-full h-full object-cover absolute inset-0 object-top'
        }}
      {% endif %}
    {% endif %}

    {% if video != blank %}
      {{
        video
        | video_tag:
          class: 'w-full h-full object-cover absolute inset-0 z-0 object-top',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          poster: video.preview_image,
          playsinline: true,
          data-autopause: true
      }}
    {% endif %}

    <div class="absolute inset-0 flex size-full flex-col justify-between lg:hidden">
      <div>
        {% if title != blank %}
          {% render 'title',
            title: title,
            text_size: 'fn-tt-title-70',
            extra_wrapper_classes: 'text-center px-24 overflow-hidden mt-40',
            bg_lines: 'bg-white-lines',
            text_color: 'text-white',
            extra_text_classes: '!leading-[0.98]'
          %}
        {% endif %}
      </div>

      {% if blocks.size > 0 %}
        <div class="flex flex-col gap-y-8 px-24 pb-24 ">
          {% for block in blocks %}
            {% if block.type == 'cta' %}
              {% render 'cta',
                text: block.settings.cta_text,
                as: 'a',
                href: block.settings.cta_link,
                extra_classes: 'w-full z-10',
                hasIcons: true,
                cta_color: block.settings.cta_color
              %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="hidden flex-col justify-between bg-orange lg:flex">
    {% if title != blank %}
      {% render 'title',
        title: title,
        text_size: 'fn-tt-title-70',
        extra_wrapper_classes: 'text-center px-24 overflow-hidden mt-40',
        bg_lines: 'bg-blue-lines',
        text_color: 'text-blue',
        extra_text_classes: '!leading-[0.98]'
      %}
    {% endif %}
    {% if blocks.size > 0 %}
      <div class="flex flex-col gap-y-16 px-40 pb-40 ">
        {% for block in blocks %}
          {% if block.type == 'cta' %}
            {% assign cta_color = block.settings.cta_color %}
            {% if cta_color == 'orange' %}
              {% assign cta_color = 'white' %}
            {% endif %}
            {% render 'cta',
              text: block.settings.cta_text,
              as: 'a',
              href: block.settings.cta_link,
              extra_classes: 'w-full z-10',
              hasIcons: true,
              cta_color: cta_color
            %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

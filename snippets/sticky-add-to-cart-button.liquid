{% assign product_is_available = product.available %}

<sticky-add-to-cart-element>
  <div
    style="z-index: 90"
    class="sticky-add-to-cart-button fixed bottom-0 right-0 z-[10] flex w-full translate-y-full transform flex-row-reverse gap-24 bg-white px-24 py-16 transition duration-300 ease-in-out lg:w-1/2 lg:flex-row lg:gap-24 lg:border-l lg:border-t lg:border-black/15"
  >
    {% render 'buy-button',
      text: cta,
      extra_classes: 'w-full',
      cta_color: cta_color,
      hasIcons: true,
      type: 'button',
      name: 'add',
      product_is_available: product_is_available,
      is_slim: true,
      extra_attributes: 'data-sticky-add-to-cart'
    %}

    <div class="flex flex-col justify-center gap-2 lg:w-full lg:flex-row lg:items-center lg:gap-24">
      <div data-sticky-price>
        <div class="flex flex-col lg:flex-row lg:items-baseline lg:gap-8 fn-tt-cta-40">
          {% render 'one-time-price', variant: product.selected_or_first_available_variant %}
        </div>
      </div>

      {% comment %} Filled + shown by ctr-build-your-pack once the shopper picks "Customize your pack". {% endcomment %}
      <div class="hidden" data-sticky-byp-price>
        <div class="flex flex-col lg:flex-row lg:items-baseline lg:gap-8 fn-tt-cta-40">
          <span class="price" data-sticky-byp-amount></span>
          <span class="fn-tt-caption igComparePrice line-through" data-sticky-byp-compare></span>
        </div>
      </div>

      {% if product.selling_plan_groups.size > 1 %}
        <a href="#product-form" aria-label="{{ text }}" data-sticky-all-options>
          <div class="flex items-center gap-4 lg:justify-center lg:gap-8">
            <p class="fn-tt-caption-20 lg:fn-tt-cta-40 whitespace-nowrap uppercase">{{ text }}</p>
            {% render 'icon-thick-arrow', class: 'w-10 lg:w-16 -rotate-90' %}
          </div>
        </a>
      {% endif %}
    </div>
  </div>
</sticky-add-to-cart-element>

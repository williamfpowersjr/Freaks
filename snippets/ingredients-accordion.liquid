<style>
  #product-filter-accordion button[aria-expanded='true'] {
    border-bottom: 1px solid #d9d9d9;
  }
</style>

<accordion-element id="product-filter-accordion">
  {% for accordion in accordions %}
    {% assign title = accordion.name %}
    {% assign teaser_image = accordion.image %}
    {% assign description = accordion.description %}
    {% assign text_image = accordion.text_image %}

    <div
      data-accordion
      data-no-autoscroll
      class="flex w-full flex-col border-b border-r  border-grey-DARK "
    >
      <button
        aria-label="Ingredient"
        aria-expanded="false"
        aria-controls="content-{{ forloop.index0 }}"
        data-accordion-trigger
        class="group flex w-full items-center justify-between border-transparent transition-[background-color] duration-300 ease-in-out lg:hover:bg-orange/15"
      >
        <div class="flex h-full min-h-64 flex-1 items-center gap-16 border-r border-black/15 py-12 pl-24 pr-40 text-left  lg:min-h-80 lg:p-16">
          {% if teaser_image %}
            {{
              teaser_image
              | image_url: width: teaser_image.width
              | image_tag: loading: 'lazy', sizes: '25vw', class: 'rounded-full w-40 h-40 lg:w-[48px] lg:h-[48px]'
            }}
          {% endif %}

          <h3 class="fn-tt-body-20 font-medium">
            {{ title }}
          </h3>
        </div>
        <div class="flex h-64 w-64 items-center justify-center lg:h-80 lg:w-80">
          {% render 'plus-animation' %}
        </div>
      </button>
      <div
        id="content-{{ forloop.index0 }}"
        data-accordion-content
        style="max-height: 0;"
        class="max-h-0 overflow-hidden transition-all ease-in-out will-change-[max-width] "
      >
        <div class="inline-rich-text fn-tt-body-20 p-24  lg:px-80 lg:py-40">
          {{ description | metafield_tag }}
          {% if text_image %}
            {{
              text_image
              | image_url: width: text_image.width
              | image_tag: loading: 'lazy', sizes: '25vw', class: 'aspect-[365/209] lg:aspect-[925/530] w-full'
            }}
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}
</accordion-element>

{% if block.settings.image != blank %}
  <div class="{% if block.settings.padding %}p-24 lg:p-40 {% endif %} h-full overflow-hidden {{ additional_classes }}">
    <div class="relative h-full overflow-hidden">
      {{
        block.settings.image
        | image_url: width: 2000
        | image_tag: class: 'w-full h-full object-cover absolute inset-0', sizes: '(min-width: 1024px) 50vw, 100vw'
      }}
      {% if block.settings.caption != blank %}
        <div class="absolute bottom-0 left-0 flex h-16 w-fit items-center justify-center bg-white px-6">
          <p class="fn-tt-caption">
            {{ block.settings.caption }}
          </p>
        </div>
      {% endif %}
      {% if block.settings.tag != blank %}
        <div class="absolute left-16 top-16 flex h-26 w-fit items-center justify-center bg-blue px-6 text-white">
          <p class="fn-tt-body-10">
            {{ block.settings.tag }}
          </p>
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}

{% comment %}
  PDP Video Carousel
  ------------------
  Horizontally scrollable carousel of muted, autoplaying videos. Used by the
  `video_carousel_item` blocks of the Product Hero section, rendered immediately
  below the Add to Cart button.

  Scrolling/swiping is native CSS scroll-snap (no Swiper dependency), so the
  carousel is visible and swipeable even before JS runs. JS only enhances:
    - <pdp-video-carousel> (frontend/js/pdp-video-carousel.ts) -> all-visible autoplay + drag-scroll
    - <video-element>      (frontend/js/video-controls.ts, reused) -> tap to play/pause, mute toggle
    - 'lazy-video' snippet -> lazy-loaded <video> (vanilla-lazyload, .lazy)

  Accepts:
    - blocks  : section.blocks (filtered here to `video_carousel_item`)
    - heading : optional heading text shown above the carousel
{% endcomment %}

{% assign video_items = blocks | where: 'type', 'video_carousel_item' %}

{% if video_items.size > 0 %}
  <pdp-video-carousel
    id="pdp-video-carousel-{{ section.id }}"
    class="block w-full"
  >
    {% if heading != blank %}
      <h2 class="font-neue text-[16px] font-medium uppercase leading-none tracking-tight lg:text-[20px]">
        {{ heading }}
      </h2>
    {% endif %}

    <div
      data-pdp-carousel-track
      class="mt-12 flex cursor-grab select-none snap-x snap-mandatory gap-8 overflow-x-auto overflow-y-hidden [-ms-overflow-style:none] [scrollbar-width:none] active:cursor-grabbing lg:mt-16 lg:snap-none [&::-webkit-scrollbar]:hidden"
    >
      {% for block in video_items %}
        {% assign is_first = false %}
        {% if forloop.first %}
          {% assign is_first = true %}
        {% endif %}

        <div
          class="w-[273px] shrink-0 snap-start"
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <video-element class="block">
            {% comment %} Label (above the video, sized to its text) {% endcomment %}
            {% if block.settings.label != blank %}
              <div class="flex w-fit items-center bg-orange p-4">
                <span class="font-neue text-[14px] font-medium uppercase leading-[0.9] tracking-tight text-white">
                  {{ block.settings.label }}
                </span>
              </div>
            {% endif %}

            <div class="relative h-[350px] overflow-hidden bg-black lg:h-[375px]">
              {% comment %} The video (tap anywhere to play/pause) {% endcomment %}
              <div data-whole-video-toggle class="absolute inset-0 z-0">
                {% render 'lazy-video',
                  video: block.settings.video,
                  class: 'w-full h-full object-cover absolute inset-0',
                  autoplay: is_first,
                  muted: true,
                  loop: true,
                  playsinline: true,
                  lazy_poster: true,
                  controls: false
                %}
              </div>

              {% comment %} Play / Pause (top-right) {% endcomment %}
              <div class="absolute right-12 top-12 z-30 flex text-white">
                <button
                  type="button"
                  aria-label="Pause video"
                  data-video-pause
                  class="group/pause p-10 transition-opacity duration-200 ease-in-out"
                  style="background: rgba(33, 33, 33, 0.15); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"
                >
                  {% render 'icon-pause',
                    class: 'w-20 transition-opacity duration-200 ease-in-out lg:group-hover/pause:opacity-80'
                  %}
                </button>
                <button
                  type="button"
                  aria-label="Play video"
                  data-video-play
                  class="group/play hidden p-10 transition-opacity duration-200 ease-in-out"
                  style="background: rgba(33, 33, 33, 0.15); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"
                >
                  {% render 'icon-play',
                    class: 'w-20 transition-opacity duration-200 ease-in-out lg:group-hover/play:opacity-80'
                  %}
                </button>
              </div>

              {% comment %} Caption (bottom-center) {% endcomment %}
              {% if block.settings.caption != blank %}
                <div class="pointer-events-none absolute inset-x-0 bottom-24 z-20 px-16 text-center">
                  <p class="fn-tt-body-20 font-medium text-white">{{ block.settings.caption }}</p>
                </div>
              {% endif %}

              {% comment %} Mute / Unmute (bottom-left) {% endcomment %}
              <div class="absolute bottom-12 left-12 z-30 flex text-white">
                <button
                  type="button"
                  aria-label="Mute video"
                  data-video-mute
                  class="group/mute hidden p-10 transition-opacity duration-200 ease-in-out"
                  style="background: rgba(33, 33, 33, 0.15); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"
                >
                  {% render 'icon-mute',
                    class: 'w-20 transition-opacity duration-200 ease-in-out lg:group-hover/mute:opacity-80'
                  %}
                </button>
                <button
                  type="button"
                  aria-label="Unmute video"
                  data-video-unmute
                  class="group/unmute p-10 transition-opacity duration-200 ease-in-out"
                  style="background: rgba(33, 33, 33, 0.15); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none"
                    aria-hidden="true"
                    class="w-20 transition-opacity duration-200 ease-in-out lg:group-hover/unmute:opacity-80"

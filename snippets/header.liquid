<div
  class="h-23 border-b border-black/15 bg-white px-8"
>
  <div class="flex h-full items-center justify-between gap-x-8">
    <div class="hidden items-center lg:flex">
      <p class="text-xl font-medium">{{ text }}</p>
    </div>
    <div>
      <a href="/" aria-label="Index Page">
        {% if logo %}
          {{
            logo
            | image_url: width: logo.width
            | image_tag: loading: 'lazy', sizes: '25vw', class: 'block h-16 lg:h-19 w-fit', alt: site_name
          }}
        {% else %}
          <span class="text-xl font-medium">{{ site_name }}</span>
        {% endif %}
      </a>
    </div>
    <div class="flex items-center">
      <p class="text-xl font-medium">{{ text }}</p>
    </div>
  </div>
</div>

{% comment %}
  Cart line purchase-state controls. Styled to Figma (5200:7068 one-time / 5172:2510 subscribed);
  all data-* hooks are consumed by frontend/js/cart-line-item.ts.

  @param {line_item} line_item
  @param {number} line_item_index
  @param {boolean} has_subscription
{% endcomment %}

{% comment %}
  Drop ReCharge dynamic bundle plans (Build Your Pack). The product carries them alongside its
  regular plans with the same names, but they only apply inside the bundle. Kept only when
  the product has no other plan, so a bundle-only product still gets a selector.
{% endcomment %}
{%- assign bundle_plan_ids = ',' -%}
{%- for group in all_products['build-your-pack'].selling_plan_groups -%}
  {%- for plan in group.selling_plans -%}
    {%- assign bundle_plan_ids = bundle_plan_ids | append: plan.id | append: ',' -%}
  {%- endfor -%}
{%- endfor -%}
{%- assign has_regular_plan = false -%}
{%- for group in line_item.product.selling_plan_groups -%}
  {%- for plan in group.selling_plans -%}
    {%- assign plan_key = plan.id | prepend: ',' | append: ',' -%}
    {%- unless bundle_plan_ids contains plan_key -%}
      {%- assign has_regular_plan = true -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endfor -%}
{%- unless has_regular_plan -%}
  {%- assign bundle_plan_ids = ',' -%}
{%- endunless -%}

{% assign max_discount = 0 %}
{% for group in line_item.product.selling_plan_groups %}
  {% unless group.name == 'Pre Order' %}
    {% for plan in group.selling_plans %}
      {% for adjustment in plan.price_adjustments %}
        {% if adjustment.value_type == 'percentage' and adjustment.value > max_discount %}
          {% assign max_discount = adjustment.value %}
        {% endif %}
      {% endfor %}
    {% endfor %}
  {% endunless %}
{% endfor %}

{% if has_subscription %}
  {% assign current_plan_id = line_item.selling_plan_allocation.selling_plan.id %}

  {%- comment -%} Subscribed — "Delivered every [3 months v]" (Figma 5172:2556). {%- endcomment -%}
  {% assign selected_freq_label = line_item.selling_plan_allocation.selling_plan.name %}
  {% if selected_freq_label contains 'every ' -%}
    {%- assign selected_freq_label = selected_freq_label | split: 'every ' | last -%}
  {%- endif %}
  {% if selected_freq_label contains ' with' -%}
    {%- assign selected_freq_label = selected_freq_label | split: ' with' | first -%}
  {%- endif %}
  <div class="flex flex-wrap items-center gap-x-[12px] gap-y-4">
    <span class="font-text text-[12px] leading-[1.5] text-[#212121]">Delivered every</span>
    {%- comment -%}
      Visible label + caret sit together; the real <select> overlays them (transparent, full-size)
      so it opens on tap and the label re-renders server-side on change — the chevron always hugs
      the value regardless of its length, instead of the native select's widest-option width.
    {%- endcomment -%}
    <div class="relative inline-flex items-center gap-[6px]">
      <label class="sr-only" for="frequency-{{ line_item_index }}"
        >Delivery frequency for {{ line_item.title | escape -}}
      </label>
      <span class="font-text text-[12px] font-medium leading-[1.5] text-[#fe5000] underline">
        {{- selected_freq_label -}}
      </span>
      <span class="flex items-center text-[#212121]">
        <svg class="h-16 w-16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M13.265 6.265L8.265 11.265C8.19469 11.3352 8.09938 11.3747 8 11.3747C7.90062 11.3747 7.80531 11.3352 7.735 11.265L2.735 6.265C2.66876 6.19391 2.6327 6.09989 2.63441 6.00274C2.63613 5.90559 2.67548 5.8129 2.74419 5.74419C2.8129 5.67548 2.90559 5.63613 3.00274 5.63441C3.09989 5.6327 3.19391 5.66876 3.265 5.735L8 10.4694L12.735 5.735C12.8061 5.66876 12.9001 5.6327 12.9973 5.63441C13.0944 5.63613 13.1871 5.67548 13.2558 5.74419C13.3245 5.8129 13.3639 5.90559 13.3656 6.00274C13.3673 6.09989 13.3312 6.19391 13.265 6.265Z" fill="currentColor"/>
        </svg>
      </span>
      <select
        id="frequency-{{ line_item_index }}"
        data-frequency-select
        class="absolute inset-0 h-full w-full cursor-pointer opacity-0"
      >
        {% for group in line_item.product.selling_plan_groups %}
          {% unless group.name == 'Pre Order' %}
            {% for plan in group.selling_plans %}
              {%- assign plan_key = plan.id | prepend: ',' | append: ',' -%}
              {% if bundle_plan_ids contains plan_key %}{% continue %}{% endif %}
              {% assign freq_label = plan.name %}
              {% if freq_label contains 'every ' -%}
                {%- assign freq_label = freq_label | split: 'every ' | last -%}
              {%- endif %}
              {% if freq_label contains ' with' -%}
                {%- assign freq_label = freq_label | split: ' with' | first -%}
              {%- endif %}
              <option
                value="{{ plan.id }}"
                {% if plan.id == current_plan_id %}
                  selected
                {% endif %}
              >
                {{ freq_label }}
              </option>
            {% endfor %}
          {% endunless %}
        {% endfor %}
        <option value="">One-time purchase</option>
      </select>
    </div>
  </div>

{% else %}
  {%- comment -%}
    Default plan — the PDP's rule (subscription-item.liquid): iterate reversed, first
    non-"Pre Order" plan wins, so cart and PDP always land on the same plan. Drives the
    single-plan pill; with several plans it only sets which option the picker opens on.
  {%- endcomment -%}
  {% assign default_plan_id = '' %}
  {% assign plan_count = 0 %}
  {% for group in line_item.product.selling_plan_groups reversed %}
    {% unless group.name == 'Pre Order' %}
      {% for plan in group.selling_plans reversed %}
        {%- assign plan_key = plan.id | prepend: ',' | append: ',' -%}
        {% unless plan.name == 'Pre Order' or bundle_plan_ids contains plan_key %}
          {% assign plan_count = plan_count | plus: 1 %}
          {% if default_plan_id == blank %}
            {% assign default_plan_id = plan.id %}
          {% endif %}
        {% endunless %}
      {% endfor %}
    {% endunless %}
  {% endfor %}

  {%- capture pill_label -%}
    {{ settings.subscription_text | default: 'Subscribe' }}
    {%- if settings.show_subscription_discount != false and max_discount > 0 %} {{ max_discount }}%{% endif -%}
  {%- endcapture -%}
  {% assign pill_classes = 'duration-250 flex items-center border-[0.6px] border-dashed border-orange bg-[#f9e9e1] px-[4px] py-[2px] text-orange transition-colors ease-in-out lg:group-hover:bg-orange lg:group-hover:text-white' %}
  {% assign pill_text_classes = 'font-text text-[12px] font-medium uppercase leading-[15.6px]' %}

  {%- comment -%}
    One-time — dashed "SUBSCRIBE + SAVE X%" pill (Figma 5200:7068). With several plans a
    transparent native <select> covers it, so one tap opens the OS picker — same technique
    as the frequency control above, and unlike a custom menu it can't be clipped by the
    drawer's scroll container or cover the upsell strip. Hover sits on the wrapper: the
    pointer is over the select, a sibling, never over the pill. A single plan leaves
    nothing to ask, so the pill stays a one-click button.
  {%- endcomment -%}
  {% if plan_count > 1 %}
    <div class="group relative inline-flex has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-blue">
      <span data-subscription-trigger class="{{ pill_classes }}">
        <span class="{{ pill_text_classes }}">{{ pill_label | strip }}</span>
      </span>

      <label class="sr-only" for="subscribe-frequency-{{ line_item_index }}">
        Subscribe {{ line_item.title | escape }} — choose a delivery frequency
      </label>
      {%- comment -%}
        Placeholder first: preselecting a plan would mean picking that same plan fires no
        change event and the tap looks dead. Hidden, so the picker still opens on the first
        real option — PDP order, so that's the plan the PDP preselects.
      {%- endcomment -%}
      <select
        id="subscribe-frequency-{{ line_item_index }}"
        data-subscribe-select
        class="absolute inset-0 h-full w-full cursor-pointer opacity-0"
      >
        <option value="" disabled selected hidden>Choose frequency</option>
        {% for group in line_item.product.selling_plan_groups reversed %}
          {% unless group.name == 'Pre Order' %}
            {% for plan in group.selling_plans reversed %}
              {%- assign plan_key = plan.id | prepend: ',' | append: ',' -%}
              {% unless plan.name == 'Pre Order' or bundle_plan_ids contains plan_key %}
                {% assign option_label = plan.name %}
                {% if option_label contains 'every ' -%}
                  {%- assign option_label = option_label | split: 'every ' | last -%}
                {%- endif %}
                {% if option_label contains ' with' -%}
                  {%- assign option_label = option_label | split: ' with' | first -%}
                {%- endif %}
                <option value="{{ plan.id }}">Every {{ option_label }}</option>
              {% endunless %}
            {% endfor %}
          {% endunless %}
        {% endfor %}
      </select>
    </div>
  {% else %}
    <div class="group inline-flex">
      <button
        type="button"
        data-subscription-trigger
        data-subscribe-plan="{{ default_plan_id }}"
        class="{{ pill_classes }}"
      >
        <span class="{{ pill_text_classes }}">{{ pill_label | strip }}</span>
      </button>
    </div>
  {% endif %}
{% endif %}

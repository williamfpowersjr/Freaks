                {%- assign benefit_variant_ids = block.settings.benefit_variant_ids | split: ',' -%}

                {%- for id in benefit_variant_ids -%}
                  {%- assign strip_id = id | strip | plus: 0 -%}
                  {%- if strip_id == variant.id -%}
                    <div class="">
                      {% if is_secondary_subscription_style %}
                        <li class="ctr-subscription-secondary__benefit-item {{ icon_checkmark_class }}">
                          <span>{{ benefit_icon_svg }}</span>
                          <p class="fn-tt-caption lg:text-sm">{{ block.settings.title }}</p>
                        </li>
                      {% else %}
                        {% render 'checkpoint',
                          class: icon_checkmark_class,
                          icon: icon-checkmark,
                          text: block.settings.title
                        %}
                        {% render 'checkpoint', class: icon_x_class, icon: icon-x, text: block.settings.title %}
                      {% endif %}
                    </div>
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}

              {%- else -%}
                <div class="">
                  {% if is_secondary_subscription_style %}
                    <li class="ctr-subscription-secondary__benefit-item {{ icon_checkmark_class }}">
                      <span>{{ benefit_icon_svg }}</span>
                      <p class="fn-tt-caption lg:text-sm">{{ block.settings.title }}</p>
                    </li>
                  {% else %}
                    {% render 'checkpoint',
                      class: icon_checkmark_class,
                      icon: icon-checkmark,
                      text: block.settings.title
                    %}
                    {% render 'checkpoint', class: icon_x_class, icon: icon-x, text: block.settings.title %}
                  {% endif %}
                </div>
              {%- endif -%}
            {% endif %}
          {% endif %}
        {% endfor %}
      </ul>
      <ul class="flex flex-col gap-16 py-16 lg:flex-row lg:flex-wrap xl:py-24 [fieldset:has(#selling\_plan\_subscription--{{ id }}:checked)+ul+&]:hidden">
        {%- assign icon_x_class = '[.js-subscription-active_&]:hidden' -%}
        {%- assign icon_checkmark_class = '[.js-one-time-active_&]:hidden' -%}
        {% if is_secondary_subscription_style %}
          {%- assign icon_x_class = '' -%}
          {%- assign icon_checkmark_class = '' -%}
        {% endif %}

        {%- if current_variant.metafields.custom.subscription_benefits.value != blank -%}
          {%- for benefit in current_variant.metafields.custom.subscription_benefits.value -%}
            {% if is_secondary_subscription_style %}
              <li class="ctr-subscription-secondary__benefit-item {{ icon_checkmark_class }}">
                <span>{{ benefit_icon_svg }}</span>
                <p class="fn-tt-caption lg:text-sm">{{ benefit }}</p>
              </li>
            {% else %}
              {% render 'checkpoint', class: icon_checkmark_class, icon: icon-checkmark, text: benefit %}
              {% render 'checkpoint', class: icon_x_class, icon: icon-x, text: benefit %}
            {% endif %}
          {%- endfor -%}
        {%- endif -%}

        {% for block in section.blocks %}
          {% if block.type == 'subscription_benefit' %}
            {% if block.settings.title != blank %}
              {%- if block.settings.benefit_variant_ids != blank -%}
                {%- assign benefit_variant_ids = block.settings.benefit_variant_ids | split: ',' -%}

                {%- for id in benefit_variant_ids -%}
                  {%- assign strip_id = id | strip | plus: 0 -%}
                  {%- if strip_id == variant.id -%}
                    <div class="">
                      {% if is_secondary_subscription_style %}
                        <li class="ctr-subscription-secondary__benefit-item {{ icon_checkmark_class }}">
                          <span>{{ benefit_icon_svg }}</span>
                          <p class="fn-tt-caption lg:text-sm">{{ block.settings.title }}</p>
                        </li>
                      {% else %}
                        {% render 'checkpoint',
                          class: icon_checkmark_class,
                          icon: icon-checkmark,
                          text: block.settings.title
                        %}
                        {% render 'checkpoint', class: icon_x_class, icon: icon-x, text: block.settings.title %}
                      {% endif %}
                    </div>
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}

              {%- else -%}
                <div class="">
                  {% if is_secondary_subscription_style %}
                    <li class="ctr-subscription-secondary__benefit-item {{ icon_checkmark_class }}">
                      <span>{{ benefit_icon_svg }}</span>
                      <p class="fn-tt-caption lg:text-sm">{{ block.settings.title }}</p>
                    </li>
                  {% else %}
                    {% render 'checkpoint',
                      class: icon_checkmark_class,
                      icon: icon-checkmark,
                      text: block.settings.title
                    %}
                    {% render 'checkpoint', class: icon_x_class, icon: icon-x, text: block.settings.title %}
                  {% endif %}
                </div>
              {%- endif -%}
            {% endif %}
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  {%- endif -%}
</div>

<script>
  (() => {
    const bindPlanDropdowns = () => {
      const dropdowns = document.querySelectorAll('[data-plan-dropdown]');
      dropdowns.forEach((dropdown) => {
        if (dropdown.dataset.dropdownBound === 'true') return;

        const nativeSelect = dropdown.querySelector('[data-plan-native]');
        const trigger = dropdown.querySelector('[data-plan-trigger]');
        const menu = dropdown.querySelector('[data-plan-menu]');
        const current = dropdown.querySelector('[data-plan-current]');
        const options = dropdown.querySelectorAll('[data-plan-option]');

        if (!nativeSelect || !trigger || !menu || !current || options.length === 0) return;

        const syncState = () => {
          const selected = nativeSelect.options[nativeSelect.selectedIndex];
          if (selected) current.textContent = selected.textContent?.trim() || '';
          options.forEach((option) => {
            option.classList.toggle('is-active', option.dataset.planValue === nativeSelect.value);
          });
        };

        trigger.addEventListener('click', () => {
          if (trigger.disabled) return;
          menu.classList.toggle('hidden');
          trigger.setAttribute('aria-expanded', menu.classList.contains('hidden') ? 'false' : 'true');
        });

        options.forEach((option) => {
          option.addEventListener('click', () => {
            const value = option.dataset.planValue || '';
            if (!value) return;
            nativeSelect.value = value;
            nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
            syncState();
            menu.classList.add('hidden');
            trigger.setAttribute('aria-expanded', 'false');
          });
        });

        document.addEventListener('click', (event) => {
          if (!dropdown.contains(event.target)) {
            menu.classList.add('hidden');
            trigger.setAttribute('aria-expanded', 'false');
          }
        });

        nativeSelect.addEventListener('change', syncState);
        syncState();
        dropdown.dataset.dropdownBound = 'true';
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindPlanDropdowns);
    } else {
      bindPlanDropdowns();
    }

    document.addEventListener('shopify:section:load', bindPlanDropdowns);
    document.addEventListener('shopify:section:select', bindPlanDropdowns);
  })();
</script>

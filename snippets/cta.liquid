{% comment %}
  Renders a customizable element (button, anchor, or div) with various styling and functionality options.

  Accepts:
  - as (String): Determines the HTML tag to be rendered. Options are 'a', 'button', 'div' or 'marquee'.
  - text (String): Central text to display on the element. Optional.
  - href (String): URL the element points to. Only applicable for 'anchor'. If provided with 'anchor', renders an <a> element.
  - extra_classes (String): Additional CSS classes to apply to the element for further styling. Optional.
  - extra_attributes (String): Additional HTML attributes to add to the element for added functionality or tracking. Optional.
  - hasIcon (Boolean): Determines if an icon should be displayed on the right side of the element. Optional.
  - hasIcons (Boolean): Determines if two icons should be displayed on the right side of the element. Optional.
  - extra_icon_classes (String): Additional CSS classes to apply to the element for further styling. Optional.
  - onclick (String): JavaScript code to run on click. Optional.
  - cta_color: Defines Background color
  - aria_label (String): Accessible name for the 'button' variant. Defaults to 'Cta'. Optional.
  - price_block_html (String): Optional HTML that fully renders the price block. If present, it replaces the internal price and compare block.
{% endcomment %}

{% assign as = as | default: 'button' %}
{% assign base_classes = 'relative overflow-hidden group max-h-56 leading-none relative px-16 py-18 flex items-stretch font-medium uppercase transition-all duration-300 ease-in-out focus:border focus:backdrop-blur-[9px] disabled:bg-black/40 disabled:text-white disabled:cursor-not-allowed focus:border-none focus-visible:border-none' %}
{% if is_slim == true %}
  {% assign base_classes = 'relative overflow-hidden group max-h-56 leading-none relative px-16 py-8 flex items-stretch font-medium uppercase transition-all duration-300 ease-in-out focus:border focus:backdrop-blur-[9px] disabled:bg-black/40 disabled:text-white disabled:cursor-not-allowed focus:border-none focus-visible:border-none' %}
{% elsif cta_color == 'blue--invert' %}
  {% assign base_classes = 'relative overflow-hidden group max-h-56 leading-none relative px-16 py-18 flex items-stretch font-medium uppercase transition-all duration-300 ease-in-out focus:border focus:backdrop-blur-[9px] disabled:bg-black/20 disabled:text-blue disabled:cursor-not-allowed focus-visible:border-none' %}
{% endif %}
{% if hasIcon or hasIcons %}
  {% assign justify_class = 'justify-between' %}
{% else %}
  {% assign justify_class = 'justify-center' %}
{% endif %}

{% assign text_classes = extra_text_classes | default: 'fn-tt-cta-40' %}

{% if onclick %}
  {% assign onclick_attribute = 'onclick="' | append: onclick | append: '"' %}
{% else %}
  {% assign onclick_attribute = '' %}
{% endif %}

{% assign base_classes = base_classes | append: ' ' | append: justify_class %}

{% if cta_color == 'orange' %}
  {% assign color_classes = 'text-white bg-orange' %}
  {% assign hover_classes = 'from-black/15 to-black/15' %}
{% elsif cta_color == 'blue' %}
  {% assign color_classes = 'text-white bg-blue' %}
  {% assign hover_classes = 'from-black/15 to-black/15' %}
{% elsif cta_color == 'blue--invert' %}
  {% assign color_classes = 'text-blue bg-white disabled:text-black/60 border border-blue' %}
  {% assign hover_classes = 'from-black/15 to-black/15' %}
{% elsif cta_color == 'white' %}
  {% assign color_classes = 'text-black bg-white disabled:text-black/60' %}
  {% assign hover_classes = 'from-black/15 to-black/15' %}
{% elsif cta_color == 'black' %}
  {% assign color_classes = 'text-white bg-black' %}
  {% assign hover_classes = 'from-white/15 to-white/15' %}
{% endif %}

{% if color_classes != empty %}
  {% assign classes = base_classes | append: ' ' | append: color_classes %}
{% endif %}

{% if extra_classes != empty %}
  {% assign classes = classes | append: ' ' | append: extra_classes %}
{% endif %}

{% assign icon_classes = 'w-14' %}

{% if extra_icon_classes != empty %}
  {% assign icon_classes = icon_classes | append: ' ' | append: extra_icon_classes %}
{% endif %}

{% capture content %}

    {% if hasIcon %}
    <div class="mr-8 flex items-center {% if as != 'marquee' %}transition duration-300 ease-in-out lg:group-has-[:focus]:-translate-y-60 lg:group-has-[:hover]:-translate-y-60{% endif %}">
      {% render 'icon-thick-small-arrow', class: icon_classes %}
    </div>
    {% elsif hasIcons %}
    <div class="flex items-center {% if as != 'marquee' %}transition duration-300 ease-in-out lg:group-has-[:focus]:-translate-y-60 lg:group-has-[:hover]:-translate-y-60{% endif %}">
      {% render 'icon-thick-small-arrow', class: icon_classes %}
    </div>
  {% endif %}
   {% if text %}
    <div class="-mb-1 flex items-center justify-center gap-x-12 text-center z-10{% if as != 'marquee' %}transition duration-300 ease-in-out lg:group-has-[:focus]:-translate-y-60 lg:group-has-[:hover]:-translate-y-60 delay-[20ms]{% endif %} {{ text_classes }}">
     <span>{{ text }}</span>
    {% if price_block_html %}
      {{ price_block_html }}
    {% elsif price != blank %}
    <div class="flex flex-wrap items-baseline gap-x-8 text-center">
     <span class="igPrice">{{ price }}</span>
      {% if compare_at_price > price %}
        <span class="fn-tt-caption igComparePrice inline text-white/60 line-through">{{ compare_at_price }}</span>
      {% endif %}
      </div>
    {% endif %}
    </div>
  {% endif %}
    {% if hasIcons %}
    <div class="flex items-center {% if as != 'marquee' %}transition duration-300 ease-in-out lg:group-has-[:focus]:-translate-y-60 lg:group-has-[:hover]:-translate-y-60 delay-[40ms]{% endif %}">
      {% render 'icon-thick-small-arrow', class: icon_classes %}
    </div>
  {% endif %} 

{% comment %} HOVER {% endcomment %}
{% if as != 'marquee' and disabled_attribute != "disabled" %}
<div class="hidden lg:absolute lg:flex lg:overflow-hidden lg:px-16 {% if is_slim == true %}lg:py-8{% else %}lg:py-18{% endif %} lg:left-0 lg:top-0 lg:h-full lg:w-full lg:items-stretch lg:justify-between">
<span class="transform overflow-hidden {% unless hover_only == true %} bg-black/15 {% endunless %} absolute left-0 top-0 h-full w-full {{ hover_classes }} translate-y-full transition duration-300 ease-in-out group-has-[:focus]:translate-y-0 group-has-[:hover]:translate-y-0"></span> 
    {% if hasIcon %}
    <div class="mr-8 flex translate-y-60 items-center transition duration-300 ease-in-out lg:group-has-[:focus]:translate-y-0 lg:group-has-[:hover]:translate-y-0">
      {% render 'icon-thick-small-arrow', class: icon_classes %}
    </div>
    {%elsif hasIcons %}
    <div class="flex translate-y-60 items-center transition duration-300 ease-in-out lg:group-has-[:focus]:translate-y-0 lg:group-has-[:hover]:translate-y-0">
      {% render 'icon-thick-small-arrow', class: icon_classes %}
    </div>
  {% endif %}
  {% if text %}
    <div class="z-10 -mb-1 flex w-full flex-1 translate-y-60 items-center justify-center gap-x-12 text-center transition delay-[20ms] duration-300 ease-in-out lg:group-has-[:focus]:translate-y-0 lg:group-has-[:hover]:translate-y-0 {{ text_classes }}">
      <span>{{ text }}</span>
      {% if price_block_html %}
        {{ price_block_html }}
      {% elsif price != blank %}
      <div class="flex flex-wrap items-baseline gap-x-8 text-center">
      <span class="igPrice">{{ price }}</span>
        {% if compare_at_price > price %}
          <span class="fn-tt-caption igComparePrice inline text-white/60 line-through">{{ compare_at_price }}</span>
        {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}
    {% if hasIcons %}
    <div class="flex translate-y-60 items-center transition delay-[40ms] duration-300 ease-in-out lg:group-has-[:focus]:translate-y-0 lg:group-has-[:hover]:translate-y-0" >
      {% render 'icon-thick-small-arrow', class: icon_classes %}
    </div>
  {% endif %}
  </div>
{% else %}
{% endif %}

{% endcapture %}

{% case as %}
  {% when 'a' %}
    <a href="{{ href }}" class="{{ classes }}" {{ extra_attributes }} {{ data_attributes }} {{ onclick_attribute }}>
      {{ content }}
    </a>
  {% when 'button' %}
    <button
      aria-label="{{ aria_label | default: 'Cta' }}"
      name="{{ name }}"
      type="{{ type }}"
      class="{{ classes }}"
      {{ extra_attributes }}
      {{ onclick_attribute }}
      {{ disabled_attribute }}
      {{ data_attributes }}
    >
      {{ content }}
    </button>
  {% when 'div' %}
    <div class="{{ classes }}" {{ extra_attributes }} {{ onclick_attribute }} {{ data_attributes }}>
      {{ content }}
    </div>

  {% when 'marquee' %}
    <marquee-element>
      <div class="{{ classes }} !px-0" {{ extra_attributes }} {{ onclick_attribute }} {{ data_attributes }}>
        <div data-container class="relative flex w-full items-center overflow-hidden">
          <div data-content class="flex shrink-0 items-center gap-x-8">
            {{ content }}
          </div>
        </div>
      </div>
    </marquee-element>
{% endcase %}

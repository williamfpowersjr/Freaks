{%- comment -%}
  Landing page line icons. Usage: {% render 'lp-icon', icon: 'clock' %}
  Icons: clock, no-aluminum, microbiome, calendar, leaf, gift, check, star
{%- endcomment -%}
<svg class="lp-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'no-aluminum' -%}
      <circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/>
    {%- when 'microbiome' -%}
      <circle cx="8" cy="9" r="3"/><circle cx="16.5" cy="7.5" r="1.5"/><circle cx="15.5" cy="15.5" r="3.5"/><circle cx="7" cy="17" r="1.5"/>
    {%- when 'calendar' -%}
      <rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
    {%- when 'leaf' -%}
      <path d="M5 19c0-9 5-14 15-14 0 10-5 15-14 14"/><path d="M5 19c2-5 5-8 10-10"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="9" width="17" height="11.5" rx="1"/><path d="M3.5 13h17M12 9v11.5"/><path d="M12 9C10 4 5 5 7 8c1 1 3 1 5 1zm0 0c2-5 7-4 5-1-1 1-3 1-5 1z"/>
    {%- when 'star' -%}
      <path d="M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.8z"/>
    {%- else -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"/>
  {%- endcase -%}
</svg>

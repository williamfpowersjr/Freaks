{% comment %} MOBILE {% endcomment %}

{% if product_url != blank %}
  <a class="lg:hidden" href="{{ product_url }}" aria-label="{{ product_title }}">
{% endif %}
<div class="relative flex h-full min-w-40 items-center justify-start gap-8 overflow-hidden py-8 pr-8 lg:hidden {{ bg_color }} duration-250 transition-colors ease-in-out ">
  <div
    class="relative ml-4 h-56 w-48 overflow-hidden"
  >
    {{
      product_image
      | image_url: width: product_image.width
      | image_tag:
        loading: 'lazy',
        sizes: '(min-width: 1024px) 50vw, 100vw',
        class: 'w-full h-full object-cover absolute inset-0 z-0'
    }}
  </div>

  <div class="flex flex-col text-left">
    <h3 class="fn-tt-body-20">{{ product_title }}</h3>
    <p class="fn-tt-body-20 text-black/60">{{ product_type }}</p>
  </div>
</div>
{% if product_url != blank %}</a>{% endif %}

{% comment %} DESKTOP {% endcomment %}

{% if product_url != blank %}
  <a class="hidden lg:flex lg:h-full lg:flex-1" href="{{ product_url }}" aria-label="{{ product_title }}">
{% endif %}
<div class="relative hidden lg:flex lg:min-h-184 lg:max-w-152 lg:flex-col lg:overflow-hidden {{ bg_color }} duration-250 transition-colors ease-in-out lg:hover:bg-orange/15 ">
  <div
    class="relative overflow-hidden lg:mb-8 lg:ml-0 lg:mt-16 lg:flex lg:h-92 lg:w-auto"
  >
    {{
      product_image
      | image_url: width: product_image.width
      | image_tag:
        loading: 'lazy',
        sizes: '(min-width: 1024px) 50vw, 100vw',
        class: 'lg:w-full lg:h-full lg:object-contain lg:absolute lg:inset-0 lg:z-0'
    }}
  </div>

  <div class="lg:flex lg:flex-1 lg:flex-col lg:items-center lg:justify-center lg:p-16 lg:pt-0 lg:text-center">
    <h3 class="lg:fn-tt-body-10 ">{{ product_title }}</h3>
    <p class="lg:fn-tt-body-10 text-black/60">{{ product_type }}</p>
  </div>
</div>
{% if product_url != blank %}</a>{% endif %}

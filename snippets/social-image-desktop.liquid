<div class="mx-80 mb-80 hidden lg:grid lg:grid-cols-1 xl:grid-cols-2 ">
  {% if social_image != blank %}
    <div
      class="relative h-full w-full overflow-hidden lg:aspect-square xl:aspect-auto xl:min-h-464"
    >
      {{
        social_image
        | image_url: width: social_image.width
        | image_tag:
          loading: 'lazy',
          sizes: '(min-width: 1024px) 50vw, 100vw',
          class: 'w-full h-full object-cover absolute inset-0 z-0'
      }}
    </div>
  {% endif %}
  <div class="flex flex-col justify-between gap-y-24 border  border-black/15  bg-offWhite px-24  py-16 lg:border-t-0 xl:border-l-0 xl:border-t">
    {% if social_quote != blank %}
      <p class="fn-tt-body-30">{{ social_quote }}</p>
    {% endif %}
    {% if social_link != blank %}
      <a
        href="{{ social_link.url }}"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex w-fit items-center justify-center gap-x-8"
      >
        {% if social_profile_image != blank %}
          <div class="relative aspect-square h-28 overflow-hidden rounded-full">
            {{
              social_profile_image
              | image_url: width: social_profile_image.width
              | image_tag: loading: 'lazy', sizes: '20vw', class: 'size-full object-cover absolute inset-0 '
            }}
          </div>
        {% endif %}
        <p class="fn-tt-body-20 transition-opacity duration-300 ease-in-out lg:group-hover:opacity-[0.8]">
          {{ social_profile_name }}
        </p>
      </a>
    {% endif %}
  </div>
</div>

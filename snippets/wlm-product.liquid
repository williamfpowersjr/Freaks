{% assign w_continue = 'no' %}
{% assign wlmHideItem_Product = false %}
{%- assign wlmLockedTags255628 = false %}
{% for tag in customer.tags %}
  {% if tag == 'Wholesale' %}{% assign wlmLockedTags255628 = true %}{% endif %}
{% endfor %}

{% if wlm-product.collections %}
  {% for c in wlm-product.collections %}
    {% if c.id == 493545586993 %}
      {% unless customer %}
        {% assign wlmHideItem_Product = true %}
      {% else %}
        {% unless wlmLockedTags255628 %}{% assign wlmHideItem_Product = true %}{% endunless %}
      {% endunless %}
    {% endif %}
  {% endfor %}
{%- endif %}

{% if wlmHideItem_Product == true %}{% continue %}{% endif %}

{% if wlm_is_render == 'yes' %}{{- w_continue -}}{% endif %}

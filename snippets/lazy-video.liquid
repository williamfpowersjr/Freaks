{% assign mp4_sources = video.sources | where: 'format', 'mp4' %}
{% assign default_source = mp4_sources[0].url %}

{% if lazy_poster == false %}
  {% assign lazy_poster = false %}
{% else %}
  {% assign lazy_poster = true %}
{% endif %}

{% if autoplay == false %}
  {% assign autoplay = false %}
{% else %}
  {% assign autoplay = true %}
{% endif %}

{% if autopause == false %}
  {% assign autopause = false %}
{% else %}
  {% assign autopause = true %}
{% endif %}

{% if loop == false %}
  {% assign loop = false %}
{% else %}
  {% assign loop = true %}
{% endif %}

{% if muted == false %}
  {% assign muted = false %}
{% else %}
  {% assign muted = true %}
{% endif %}

{% if controls == false %}
  {% assign controls = false %}
{% else %}
  {% assign controls = false %}
{% endif %}

{% if poster != blank %}
  {% assign poster = poster %}
{% else %}
  {% assign poster = video.preview_image.src | image_url: width: 700 %}
{% endif %}

{% if playsinline == false %}
  {% assign playsinline = false %}
{% else %}
  {% assign playsinline = true %}
{% endif %}

<video
  class="lazy {{ class }}"
  data-src="{{ default_source }}"
  data-media-query="{{ media_query }}"

  {% if lazy_poster == true %}
    data-poster="{{ poster }}"
  {% else %}
    poster="{{ poster }}"
  {% endif %}

  {% if loop == true %}
    loop
  {% endif %}
  {% if muted == true %}
    muted
  {% endif %}
  {% if controls == true %}
    controls
  {% endif %}
  {% if playsinline == true %}
    playsinline
  {% endif %}
  {% if autoplay == true %}
    autoplay
  {% endif %}
  preload="none"
  {% if autopause == true %}
    data-autopause
  {% endif %}
  data-autoplay="{{ autoplay }}"
>
  {% for source in video.sources %}
    <source type="{{ source.format }}" data-src="{{ source.url }}">
  {% endfor %}

  {% if vtt != blank %}
    <track src="{{ vtt.value.url }}" kind="subtitles" srclang="en" label="English" default>
  {% endif %}
  {% comment %}
    {% if lazy_poster == true %}
      <img alt="{{ poster.alt }}" width="100%" height="100%" src="{{ poster | asset_url }}">
    {% endif %}
  {% endcomment %}
</video>
